{
  "name": "booking-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Service-booking marketplace platform — monorepo (backend + web apps)",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev --workspace apps/backend",
    "backend:build": "npm run build --workspace apps/backend",
    "backend:start": "npm run start --workspace apps/backend",
    "backend:prisma:generate": "npm run prisma:generate --workspace apps/backend",
    "backend:prisma:migrate": "npm run prisma:migrate --workspace apps/backend",
    "docker:up": "docker compose -f apps/backend/docker-compose.yml up -d",
    "docker:down": "docker compose -f apps/backend/docker-compose.yml down",
    "dev": "./scripts/dev.sh",
    "dev:no-app": "./scripts/dev.sh --no-app",
    "dev:stop": "docker compose -f apps/backend/docker-compose.yml down",
    "api:types": "./scripts/api-types.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

{
  "name": "website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "i18n:extract": "node ../../scripts/i18n/lingui.mjs extract",
    "i18n:compile": "node ../../scripts/i18n/long-words.mjs src/locales && node ../../scripts/i18n/lingui.mjs compile",
    "i18n": "npm run i18n:extract && npm run i18n:compile"
  },
  "dependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.10.0",
    "@lingui/cli": "^6.10.0",
    "@lingui/format-po": "^6.10.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^5.4.10"
  }
}

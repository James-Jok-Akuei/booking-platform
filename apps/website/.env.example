# The landing page's links (§239, §258). Each is read at build time; leave one
# empty and its button says "on its way" instead of leading nowhere.

# Where the backend is. In development `/api` is proxied to localhost:4100.
VITE_API_URL=""

# The business app's sign-in page, e.g. https://business.example.com/login.
# "Start selling" adds ?start=signup and "Sign in" adds ?start=signin.
# In development it defaults to http://localhost:5174/login.
VITE_BUSINESS_APP_URL=""

# The customer app, once it is out: the stores, or the web app.
VITE_APP_STORE_URL=""
VITE_PLAY_STORE_URL=""
VITE_CUSTOMER_APP_URL=""

# Where this site itself lives, e.g. https://bwangu.rw — no slash at the end.
# The share picture (public/og.jpg) is named by its full address, which is what
# WhatsApp and Facebook need to show it when someone sends a link (§273).
VITE_SITE_URL=""

# How to reach you, in the footer. Each line shows only when it is set.
VITE_CONTACT_EMAIL=""
VITE_CONTACT_PHONE=""

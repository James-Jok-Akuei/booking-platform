# Written by scripts/dev.sh on every start — this machine's address on the wifi,
# so a real phone can reach the backend (§108.4). Do not edit by hand.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Where a shared link points (§121.2). Empty is deliberate: there is no public
# website yet, and a share carries the shop's name and address rather than a URL
# that would 404. Set this to the real domain and every share gains a link.
EXPO_PUBLIC_SHARE_BASE_URL=

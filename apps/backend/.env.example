# Database — matches the postgres service in docker-compose.yml.
# Port 5433 (not 5432) to avoid colliding with a natively-installed Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking_platform?schema=public"

# JWT — generate real values with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP
OTP_EXPIRES_IN_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_REQUESTS_PER_HOUR="5"

# Mail (SMTP)
# Local dev defaults point at the Mailhog container from docker-compose.yml.
# Mailhog accepts unauthenticated SMTP, so SMTP_USER/SMTP_PASS are left empty —
# the mail service skips the AUTH handshake entirely when SMTP_USER is blank.
# In production, swap these for SendGrid / Resend / Postmark SMTP credentials.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Booking Platform <no-reply@yourplatform.com>"

# App
PORT="3000"
NODE_ENV="development"

# File storage — Cloudflare R2 (S3-compatible API).
# Leave these blank to fall back to local-disk uploads in ./uploads, served at
# /uploads. That fallback is DEV ONLY: the folder is not shared between
# instances and is lost on redeploy. The backend logs a warning at boot when it
# is active. Filling all five in switches to R2 with no code change.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Base URL the API is reachable at. Only used to build absolute URLs for the
# local-disk upload fallback; ignored once R2 is configured.
APP_BASE_URL="http://localhost:3000"

# Timezone used to turn a location's wall-clock opening hours ("08:30") into
# real instants when comparing them against appointment times. Platform-wide
# for MVP — every business is in one market. Becomes a Location column if the
# platform ever crosses a timezone border.
PLATFORM_TIMEZONE="Africa/Juba"

# ---------------------------------------------------------------------------
# Money — the internal unit of account
# ---------------------------------------------------------------------------
# The currency every price, deposit, fee and ledger entry is stored in, in its
# MINOR units. Not an admin setting: it is fixed for the lifetime of a
# deployment, because nothing in the database records the unit beside the
# number, so changing it would reinterpret every historical amount rather than
# convert it. The app refuses to start if it disagrees with the ledger (§55.1).
#
# Must appear in MINOR_UNIT_EXPONENT in src/payments/currency.ts. A currency
# with no minor unit (RWF, UGX) is supported; one that is not in that table is
# refused rather than assumed to have two decimal places.
#
# USD is the default because South Sudan's SSP inflates too fast to price in.
# A deployment in a stable-currency country should set its own currency here,
# so customers see an exact price rather than an approximation of one.
INTERNAL_CURRENCY="USD"

# ---------------------------------------------------------------------------
# Payments — MTN MoMo Collections
# ---------------------------------------------------------------------------
# NOTE: PAYMENT_PROVIDER was removed in §57. The platform no longer picks one
# operator at boot — it holds every provider whose credentials are configured
# and resolves per payment, because which operator a customer pays with is a
# property of their SIM, not of the deployment. An operator is available when
# its own keys below are filled in, which is a fact rather than a second setting
# to keep in sync.

# Your MoMo developer subscription keys for the Collections product, from
# https://momodeveloper.mtn.com/developer — Profile > Subscriptions. Two keys
# are issued so one can be rotated while the other stays live; only the primary
# is used, the secondary is kept for that rotation.
MOMO_SUBSCRIPTION_KEY_PRIMARY=""

# NOT READ BY THE APP. MTN's portal runs on Azure API Management, which issues
# two keys per subscription so you can rotate without downtime: point the app at
# the secondary, regenerate the primary, point it back. Kept here so the standby
# is written down somewhere, not because anything consumes it.
MOMO_SUBSCRIPTION_KEY_SECONDARY=""

# "sandbox" for the test environment. In production this becomes the country
# code MTN issues for the live deployment.
MOMO_TARGET_ENVIRONMENT="sandbox"

# https://sandbox.momodeveloper.mtn.com for sandbox; MTN issues a different
# host for production.
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"

# Generated ONCE by `npm run momo:provision`, which calls MTN's sandbox
# provisioning endpoints and prints the two values to paste back in here.
# They do not expire and do not need regenerating unless the sandbox account is
# reset. In production MTN issues these directly instead — the provisioning
# endpoints are sandbox-only.
MOMO_API_USER=""
MOMO_API_KEY=""

# NOTE: the provider currency is NO LONGER an env var. It moved to
# PlatformSetting.providerCurrency, alongside the manual USD exchange rate, so
# an admin can correct both at runtime via PATCH /admin/settings/exchange-rate
# without a redeploy. Prices are held internally in USD cents and converted at
# charge time — see DECISIONS.md.

# The country a payout mobile-money number must belong to (§48.2).
# E.164 prefix, including the +. South Sudan by default. Configurable rather
# than hardcoded so crossing a border is a config change, not a redeploy.
PAYOUT_MSISDN_COUNTRY_PREFIX="+211"

# SANDBOX TESTING AID — NEVER A CONFIG KNOB (§52.1).
#
# Rewrites the currency in the OUTBOUND MoMo request and nothing else. MTN's
# sandbox accepts only EUR, while realistic demo data is priced in SSP, so
# without this a working sandbox and a realistic dataset cannot coexist.
#
# What the customer is quoted, what is stored on the appointment and what the
# ledger settles in all remain the real providerCurrency — so while this is set,
# the provider's records and the platform's DELIBERATELY DISAGREE.
#
# The application REFUSES TO START if this is set and NODE_ENV=production.
# Leave it unset unless you are actively testing against the sandbox.
MOMO_SANDBOX_CURRENCY_OVERRIDE=""

# ---------------------------------------------------------------------------
# Payments — MTN MoMo Disbursements (money OUT)
# ---------------------------------------------------------------------------
# A SEPARATE subscription from Collections, with its own key. Subscribe at
# https://momodeveloper.mtn.com under Products > Disbursements, then copy the
# PRIMARY key from Profile > Subscriptions.
#
# Using the Collections key here fails with "subscription not found", which
# reads like a broken integration rather than a wrong key.
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY_PRIMARY=""

# No secondary variable here on purpose: one key is used at a time, and a second
# unread variable per product is config that looks load-bearing and is not. The
# standby lives in the MTN portal, which is where you would go to rotate anyway.

# Created by:  npm run momo:provision -- --disbursement
# Sandbox only. MTN issues production credentials directly.
MOMO_DISBURSEMENT_API_USER=""
MOMO_DISBURSEMENT_API_KEY=""

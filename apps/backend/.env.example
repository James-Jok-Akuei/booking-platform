# Database — matches the postgres service in docker-compose.yml.
# Port 5433 (not 5432) to avoid colliding with a natively-installed Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking_platform?schema=public"

# JWT — generate real values with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP
OTP_EXPIRES_IN_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_REQUESTS_PER_HOUR="5"

# Mail (SMTP)
# Local dev defaults point at the Mailhog container from docker-compose.yml.
# Mailhog accepts unauthenticated SMTP, so SMTP_USER/SMTP_PASS are left empty —
# the mail service skips the AUTH handshake entirely when SMTP_USER is blank.
# In production, swap these for SendGrid / Resend / Postmark SMTP credentials.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Booking Platform <no-reply@yourplatform.com>"

# App
PORT="3000"
NODE_ENV="development"

# File storage — Cloudflare R2 (S3-compatible API).
# Leave these blank to fall back to local-disk uploads in ./uploads, served at
# /uploads. That fallback is DEV ONLY: the folder is not shared between
# instances and is lost on redeploy. The backend logs a warning at boot when it
# is active. Filling all five in switches to R2 with no code change.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Base URL the API is reachable at. Only used to build absolute URLs for the
# local-disk upload fallback; ignored once R2 is configured.
APP_BASE_URL="http://localhost:3000"

# Timezone used to turn a location's wall-clock opening hours ("08:30") into
# real instants when comparing them against appointment times. Platform-wide
# for MVP — every business is in one market. Becomes a Location column if the
# platform ever crosses a timezone border.
PLATFORM_TIMEZONE="Africa/Juba"

# ---------------------------------------------------------------------------
# Payments — MTN MoMo Collections
# ---------------------------------------------------------------------------
# Which PaymentProvider implementation to use. "momo" is the only one built;
# the value exists so a future provider (NilPay, a different MTN environment)
# can be swapped in without touching booking code.
PAYMENT_PROVIDER="momo"

# Your MoMo developer subscription keys for the Collections product, from
# https://momodeveloper.mtn.com/developer — Profile > Subscriptions. Two keys
# are issued so one can be rotated while the other stays live; only the primary
# is used, the secondary is kept for that rotation.
MOMO_SUBSCRIPTION_KEY_PRIMARY=""
MOMO_SUBSCRIPTION_KEY_SECONDARY=""

# "sandbox" for the test environment. In production this becomes the country
# code MTN issues for the live deployment.
MOMO_TARGET_ENVIRONMENT="sandbox"

# https://sandbox.momodeveloper.mtn.com for sandbox; MTN issues a different
# host for production.
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"

# Generated ONCE by `npm run momo:provision`, which calls MTN's sandbox
# provisioning endpoints and prints the two values to paste back in here.
# They do not expire and do not need regenerating unless the sandbox account is
# reset. In production MTN issues these directly instead — the provisioning
# endpoints are sandbox-only.
MOMO_API_USER=""
MOMO_API_KEY=""

# NOTE: the provider currency is NO LONGER an env var. It moved to
# PlatformSetting.providerCurrency, alongside the manual USD exchange rate, so
# an admin can correct both at runtime via PATCH /admin/settings/exchange-rate
# without a redeploy. Prices are held internally in USD cents and converted at
# charge time — see DECISIONS.md.

# The country a payout mobile-money number must belong to (§48.2).
# E.164 prefix, including the +. South Sudan by default. Configurable rather
# than hardcoded so crossing a border is a config change, not a redeploy.
PAYOUT_MSISDN_COUNTRY_PREFIX="+211"

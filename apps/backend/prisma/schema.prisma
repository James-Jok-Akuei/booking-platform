// Prisma schema for the booking platform backend.
// Single database, single backend, role-based access for
// business / customer / admin as agreed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUSINESS
  CUSTOMER
  ADMIN
}

// A business account's approval status.
// New businesses land on PENDING until an admin approves them (see admin portal, later module).
//
// NOTE (approval-status rule): a PENDING business may still complete its entire
// profile — locations, hours, services, gallery. Status gates *visibility*, not
// editing. Only APPROVED businesses should ever surface in public customer-facing
// search/discovery; PENDING / REJECTED / SUSPENDED must be filtered out there.
// That filter is NOT enforced in this module — there are no public discovery
// endpoints yet. It belongs to the customer search module.
enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OtpPurpose {
  LOGIN // covers both signup and login since OTP-only auth treats them the same
}

// Who a person is within a business. Exactly one OWNER per business is an
// invariant enforced in the service layer: OWNER cannot be invited, assigned,
// removed, or demoted, so the founding signup's OWNER is permanent for MVP.
enum BusinessMemberRole {
  OWNER // full control, including membership management
  MANAGER // everything OWNER can do EXCEPT managing members and invitations
  STAFF // read-only for now; gains booking permissions with the Appointment module
}

// Soft-delete state for a membership. Removed rows are kept, never deleted, so
// the record of who had access survives.
enum BusinessMemberStatus {
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Which side of the platform raised a ticket. Derived from the authenticated
/// user's role at creation, never accepted from the request body.
enum ReporterType {
  CUSTOMER
  BUSINESS
}

enum TicketCategory {
  PAYMENT_ISSUE
  APPOINTMENT_DISPUTE
  ACCOUNT_ISSUE
  TECHNICAL_ISSUE
  OTHER
}

/// Lifecycle. Transitions are enforced in one place — see
/// TicketsService.transitionStatus — and anything not in that table throws.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketAuthorType {
  REPORTER
  ADMIN
}

/// What kind of money movement an admin recorded.
///
/// Named for how this platform actually charges (DECISIONS.md §2, §25): the
/// platform fee comes out of the customer's deposit at booking, so there is
/// nothing to "credit" against a future invoice — only a fee already taken that
/// may need refunding, or a gateway cost the business bears.
enum BillingAdjustmentType {
  /// The platform fee taken at booking should go back to the customer.
  /// Recorded when a BUSINESS cancels: the customer is refunded in full.
  FEE_REFUND

  /// The payment gateway's own charge (1-2%) on a refunded transaction, borne
  /// by the business that cancelled.
  GATEWAY_FEE_DEBIT
}

/// What happened. One value per notifiable event, so a recipient's history is
/// queryable by kind ("show me every booking I was told about") rather than by
/// parsing rendered copy.
enum NotificationType {
  APPOINTMENT_BOOKED // a customer booked; the business is told
  DEPOSIT_CONFIRMED // deposit landed; both sides are told
  APPOINTMENT_CANCELLED // called off by either side, or expired unpaid
  APPOINTMENT_NO_SHOW // business recorded a no-show
  DEPOSIT_FAILED // the payment attempt failed; the customer may retry
  APPOINTMENT_REMINDER // sent ahead of the appointment
  BUSINESS_INVITATION // someone was invited to join a business
  NEW_MESSAGE // a chat message arrived; debounced, see DECISIONS.md
  TICKET_CREATED // a support ticket was raised; admins are told
  TICKET_MESSAGE // a reply on a ticket; never sent for internal notes
  TICKET_STATUS_CHANGED // the ticket moved through its lifecycle
  REVIEW_CREATED // a customer reviewed a location; the business is told
  REVIEW_RESPONSE // the business replied to a review
  REVIEW_HIDDEN // an admin hid a review; both sides are told
  DISPLAY_NAME_CLEARED // an admin cleared a customer's review display name
}

/// How it was delivered. EMAIL is the only implementation today; SMS exists in
/// the enum because South Sudan runs on SMS far more than email, and the
/// channel abstraction is built so adding it touches no calling code.
enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING // created, not yet dispatched
  SENT
  FAILED // dispatch failed; retried by the sweep
}

// Gallery media kind. Only PHOTO is produced today — the enum exists so VIDEO
// can be added later without a destructive column-type migration.
enum MediaType {
  PHOTO
}

// Uploaded media is moderated: it lands PENDING and an admin approves or rejects
// it (admin portal, later module). Mirrors BusinessStatus in spirit.
enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The appointment lifecycle. Transitions are enforced in AppointmentsService;
/// see DECISIONS.md for the state machine and why COMPLETED has no bypass.
enum AppointmentStatus {
  PENDING_PAYMENT // created, deposit not yet paid
  BOOKED // deposit paid, slot held
  IN_PROGRESS // customer arrived and their code was verified
  COMPLETED // service delivered
  CANCELLED // called off from PENDING_PAYMENT or BOOKED
  NO_SHOW // never verified, and the window has passed
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The name shown beside this customer's reviews, on the User rather than on
  /// each Review: one source of truth means changing it changes every review at
  /// once, instead of leaving three different names across three reviews.
  ///
  /// Nullable, no backfill, and null is NOT the string "Anonymous". Readers
  /// render null as "Anonymous", which keeps a customer who deliberately typed
  /// "Anonymous" distinguishable from one who never supplied a name at all.
  /// Cleared back to null by admin moderation; see §31.
  displayName String?

  // A business user reaches their BusinessProfile through BusinessMembership,
  // never directly.
  //
  // A LIST, not a single row: someone who leaves a business keeps that
  // membership as a REMOVED row and may later join another, so the history
  // accumulates. At most one of these is ACTIVE at a time — enforced by a
  // partial unique index; see BusinessMembership.userId. Callers wanting "the
  // business this person works in" must filter to ACTIVE rather than taking
  // the first row.
  businessMemberships BusinessMembership[]

  // Invitations this user has sent. Only OWNERs can send them.
  sentInvitations BusinessInvitation[] @relation("InvitedBy")

  // Appointments booked by this user. Only populated when role = CUSTOMER.
  appointments Appointment[] @relation("CustomerAppointments")

  /// Appointments this user cancelled — as a customer, as a business member, or
  /// as an admin acting on a dispute. Who ACTED; Appointment.cancelledBy says
  /// who bears responsibility, which is a different question.
  cancelledAppointments Appointment[] @relation("CancelledAppointments")

  notifications Notification[] @relation("UserNotifications")

  threads          Thread[]          @relation("CustomerThreads")
  sentMessages     Message[]         @relation("SentMessages")
  threadReadStates ThreadReadState[] @relation("ThreadReadStates")

  reportedTickets    Ticket[]            @relation("ReportedTickets")
  assignedTickets    Ticket[]            @relation("AssignedTickets")
  ticketMessages     TicketMessage[]     @relation("TicketMessages")
  ticketAttachments  TicketAttachment[]  @relation("TicketAttachments")
  createdAdjustments BillingAdjustment[] @relation("CreatedAdjustments")

  reviews         Review[] @relation("CustomerReviews")
  hiddenReviews   Review[] @relation("HiddenReviews")
  reviewResponses Review[] @relation("ReviewResponses")

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]

  @@map("users")
}

model BusinessProfile {
  id String @id @default(uuid())

  // No userId column. A business is reached through BusinessMembership, which
  // is what allows more than one person to work in it.

  name        String? // business display name, set during onboarding
  description String?
  phone       String?

  // Taxonomy. Both nullable: the profile row is created at signup, before the
  // business has picked anything. SetNull on delete so retiring a category
  // never cascades away a business account.
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  // Business-level branding. Per-location photos live in LocationMedia instead.
  logoUrl       String?
  coverImageUrl String?

  status          BusinessStatus @default(PENDING)
  // Set by an admin when status = REJECTED, so the business is told what to fix
  // rather than being left guessing. Cleared when they resubmit.
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations   Location[]
  services    Service[]
  members     BusinessMembership[]
  invitations BusinessInvitation[]
  threads     Thread[]
  tickets     Ticket[]
  adjustments BillingAdjustment[]
  reviews     Review[]

  @@index([categoryId])
  @@index([status])
  @@map("business_profiles")
}

// ---------- Taxonomy ----------
// Seeded from prisma/seed.ts, not from a migration, so the MVP taxonomy stays
// re-runnable and editable without writing a new migration each time.

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  icon        String? // icon key/emoji for the frontends; not a URL
  description String?

  subcategories Subcategory[]
  businesses    BusinessProfile[]

  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String

  businesses BusinessProfile[]

  // Unique per parent, not globally: "Bridal Makeup" under Beauty and a
  // same-named entry under a future category must not collide.
  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("subcategories")
}

// ---------- Locations ----------

model Location {
  id         String          @id @default(uuid())
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String // e.g. "Juba Town Branch"
  address String

  // Nullable: many businesses onboard with a street address long before anyone
  // pins exact coordinates. Distance search must tolerate their absence.
  latitude  Float?
  longitude Float?

  // Optional per-location override of BusinessProfile.phone.
  phone String?

  // How many appointments this location can run at the same instant — four
  // chairs, three treatment rooms, one photographer. Defaults to 1, which is
  // exactly the behaviour every existing location had before this column
  // existed. Answers the four-chair-salon limitation noted in DECISIONS.md.
  //
  // Capacity is per LOCATION, not per staff member: there is still no staff
  // model, so this counts units of simultaneous service, not people.
  capacity Int @default(1)

  /// Denormalised review aggregates, recalculated inside the same transaction
  /// as any review change. Location browsing is a hot read path and must never
  /// run AVG() across the review table to render a star rating.
  ///
  /// Both count NON-HIDDEN reviews only. ratingAvg is null until the first
  /// review lands — meaningfully different from 0, which would read as "rated
  /// zero" rather than "not yet rated".
  ratingAvg   Decimal? @db.Decimal(3, 2)
  ratingCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hours              LocationHours[]
  reviews            Review[]
  media              LocationMedia[]
  scheduleExceptions LocationScheduleException[]
  timeBlocks         LocationTimeBlock[]
  appointments       Appointment[]

  @@index([businessId])
  @@map("locations")
}

model LocationHours {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday ... 6 = Saturday (JS Date.getDay() convention)
  openTime  String // "HH:mm", 24-hour
  closeTime String // "HH:mm", 24-hour
  isClosed  Boolean @default(false) // true = shut all day; open/close ignored

  // One row per day per location — the hours endpoint replaces the whole week.
  @@unique([locationId, dayOfWeek])
  @@index([locationId])
  @@map("location_hours")
}

// ---------- Services ----------

model Service {
  id         String          @id @default(uuid())
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Money is stored as integer cents, never a float. Binary floating point
  // cannot represent most decimal money values exactly, and the deposit /
  // platform-fee split (see DECISIONS.md §2) does arithmetic on these amounts.
  priceCents      Int
  durationMinutes Int

  /// ISO 4217 code for priceCents. Always "USD" today — the platform's internal
  /// unit of account (see DECISIONS.md).
  ///
  /// Stored explicitly even though every row reads the same value, so that a
  /// future multi-currency world never has to GUESS what an old row meant.
  /// An unlabelled amount is only unambiguous while exactly one currency has
  /// ever existed, and that property is impossible to restore afterwards.
  currency String @default("USD")

  // Share of priceCents the customer pays up front to hold the slot.
  //
  // Must be >= the live PlatformSetting.platformFeePercentage, validated on
  // every write. Both percentages apply to the same base (the service price),
  // so that floor is precisely what guarantees the platform fee never exceeds
  // the deposit it is taken from — i.e. businessAmountCents can never go
  // negative. Decimal, never Float: this multiplies money.
  depositPercentage Decimal @default(10.00) @db.Decimal(5, 2)

  // Soft-delete flag. Services are never hard-deleted: appointments booked in
  // the future will reference serviceId, and those records must still resolve
  // to a real name/price after the business stops offering the service.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([businessId])
  @@map("services")
}

// ---------- Gallery ----------

model LocationMedia {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  type   MediaType   @default(PHOTO)
  url    String
  status MediaStatus @default(PENDING)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([locationId])
  @@map("location_media")
}

// ---------- Availability ----------
//
// Availability is NOT stored. It is computed live on every request from three
// inputs: the weekly template (LocationHours), the date-specific exceptions and
// blocks below, and existing appointments. There is deliberately no table of
// pre-generated future slots — see DECISIONS.md for why.

/// A date-specific override of the weekly template. Either closes the day
/// outright or replaces that date's opening hours.
model LocationScheduleException {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // A calendar day, not an instant — @db.Date so Postgres stores no time or
  // offset. "Closed on 2026-12-25" is true regardless of what hour it is.
  date DateTime @db.Date

  isClosed Boolean @default(false)

  // Set only when isClosed = false and this date's hours differ from the
  // weekly template. Both null means "closed", both set means "open, but with
  // these hours instead". "HH:mm", 24-hour, same convention as LocationHours.
  customOpenTime  String?
  customCloseTime String?

  reason String? // e.g. "Public holiday", "Staff training"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One exception per location per date — a date cannot be both closed and
  // open-with-custom-hours. Enforced in the database, not just the service.
  @@unique([locationId, date])
  @@index([locationId, date])
  @@map("location_schedule_exceptions")
}

/// A partial-day manual block, e.g. "2pm-4pm, owner unavailable". Subtracts
/// from availability exactly the way a booked appointment does, without
/// closing the whole day. Many blocks per location per date are allowed.
model LocationTimeBlock {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  reason String?

  createdAt DateTime @default(now())

  @@index([locationId, date])
  @@map("location_time_blocks")
}

// ---------- Business membership ----------

/// Links a person to the business they work in, with a role.
///
/// Replaces the old one-user-one-business 1:1 relation. Every ownership and
/// permission decision in the business and availability modules now resolves
/// through this table.
model BusinessMembership {
  id String @id @default(uuid())

  // NOT unique here, deliberately. One business per person is still the rule,
  // but it applies only to ACTIVE rows — enforced by a PARTIAL unique index
  // that Prisma's DSL cannot express:
  //
  //   CREATE UNIQUE INDEX "business_memberships_active_userId_key"
  //     ON "business_memberships"("userId") WHERE "status" = 'ACTIVE';
  //
  // It lives in the migration for that change. A blanket @unique would let a
  // REMOVED row keep occupying the slot forever, permanently barring someone
  // from ever joining a different business after leaving one.
  //
  // The index is invisible to this schema, so Prisma neither creates nor
  // manages it. Checked with `prisma migrate diff` after applying: Prisma
  // reports no drift and does not propose dropping it — it simply cannot see
  // it. Still worth a glance whenever a generated migration touches this
  // table: if one ever contains DROP INDEX
  // "business_memberships_active_userId_key", delete that line and keep the
  // index, because nothing in the schema would restore it.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  role   BusinessMemberRole
  // Soft delete: removing a member sets REMOVED, keeping the row so the record
  // of who had access survives. Re-hiring into the same business reactivates
  // that row rather than inserting a second one.
  status BusinessMemberStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // At most one row per person per business, so someone's history with a given
  // business is a single row that flips between ACTIVE and REMOVED. This is
  // what makes the reactivation path unambiguous — there can never be two rows
  // to choose between. Expressible in Prisma, unlike the partial index above.
  @@unique([userId, businessProfileId])
  @@index([businessProfileId, status])
  @@index([userId, status])
  @@map("business_memberships")
}

/// A pending invitation for an email address to join a business.
///
/// There is no separate "accept" endpoint: verifying an OTP as a BUSINESS user
/// with a pending invitation IS acceptance. See AuthService.
model BusinessInvitation {
  id String @id @default(uuid())

  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  // Stored lowercase/trimmed, matching how AuthService normalises emails, so
  // invitation lookup at OTP verification is an exact match.
  email String

  // MANAGER or STAFF only — never OWNER. Ownership transfer does not exist in
  // MVP, so there is no path by which an invitation can create a second OWNER.
  role BusinessMemberRole

  invitedByUserId String
  invitedBy       User   @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  expiresAt DateTime

  @@index([email, status])
  @@index([businessProfileId, status])
  @@map("business_invitations")
}

// ---------- Platform settings ----------

/// Admin-tunable platform configuration, held as a single row.
///
/// Single-row rather than key-value: every setting here is strongly typed and
/// arithmetic-bearing, and a key-value table would turn `platformFeePercentage`
/// into a string that every reader has to parse and trust. The `id` is pinned
/// to a constant so there is exactly one row and no way to accidentally create
/// a second.
model PlatformSetting {
  // Fixed sentinel id — see PLATFORM_SETTING_ID in platform-settings.service.ts.
  id String @id

  /// Percentage of the service price taken as the platform's fee, deducted
  /// from the customer's deposit before the remainder reaches the business.
  ///
  /// Editable at runtime by an admin, so every booking reads it live. Already
  /// booked appointments keep the amounts computed at their booking time; see
  /// the snapshot fields on Appointment.
  platformFeePercentage Decimal @default(10.00) @db.Decimal(5, 2)

  /// The currency the payment provider actually charges in.
  ///
  /// Authoritative — this supersedes the MOMO_CURRENCY env var, so the value
  /// can be corrected by an admin without a redeploy. "EUR" is MTN's sandbox
  /// requirement; production for South Sudan is still unconfirmed.
  providerCurrency String @default("EUR")

  /// How many units of providerCurrency one USD buys.
  ///
  /// Set MANUALLY by an admin. Nullable on purpose: there is no sensible
  /// default for an exchange rate, and a wrong guess charges the customer the
  /// wrong amount. Payment initiation fails loudly when this is unset rather
  /// than falling back to anything.
  ///
  /// Decimal(18,8) gives room for both a rate near 1 (USD->EUR) and a rate in
  /// the thousands (USD->SSP) without losing precision at either end.
  exchangeRateUsdToProviderCurrency Decimal? @db.Decimal(18, 8)

  /// When the rate above was last set. Surfaced by the admin endpoint so it is
  /// obvious at a glance how stale a manually-maintained rate has become.
  exchangeRateUpdatedAt DateTime?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ---------- Appointments ----------

/// A booking. Replaces the §12 placeholder with the full lifecycle and money.
/// Who BEARS RESPONSIBILITY for a cancellation.
///
/// Not the same question as who performed it — see Appointment.cancelledByUserId.
/// This is the field the refund policy (§25) keys off: a business cancellation
/// costs the business, a customer cancellation does not, and an unpaid hold
/// released by the sweep is not a cancellation anyone owes anything for.
enum CancelledBy {
  CUSTOMER
  BUSINESS
  SYSTEM_EXPIRY
}

model Appointment {
  id String @id @default(uuid())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Required now, unlike the placeholder: an appointment is always for a
  // specific service, because that is what fixes its duration and its price.
  // Restrict, not SetNull — services are soft-deleted precisely so a booked
  // appointment always resolves to the service it was made for.
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  customerId String
  customer   User   @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Cascade)

  // Absolute instants, unlike the wall-clock "HH:mm" strings used by hours,
  // exceptions and blocks. endTime is derived server-side from the service's
  // durationMinutes at booking time, never accepted from the client.
  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(PENDING_PAYMENT)

  // ---- Money, snapshotted at booking time ----
  //
  // All three are integer cents and satisfy, permanently:
  //     platformFeeAmountCents + businessAmountCents == depositAmountCents
  //
  // They are stored rather than derived because every input can move
  // afterwards: an admin may change the platform fee, and a business may
  // change its price or deposit percentage. What the customer agreed to pay,
  // and what the business is owed, must not silently change with them.
  depositAmountCents     Int
  platformFeeAmountCents Int
  businessAmountCents    Int

  /// The INPUTS the three amounts above were computed from, snapshotted at
  /// booking and never updated.
  ///
  /// Without these the amounts cannot be explained after the fact: the service
  /// price and its deposit percentage are both editable (§10), and the platform
  /// fee percentage is an admin setting (§16.3), so joining to them later gives
  /// today's values for a historical booking. Recording the inputs alongside
  /// the outputs is what makes a past appointment reconstructable — and what
  /// makes the balance owed to the business computable at all (§29.1).
  ///
  /// Nullable with no backfill: appointments booked before this existed
  /// genuinely do not have the information, and inventing it would be worse
  /// than admitting it. Every reader must treat null as "not recorded".
  servicePriceCents     Int?
  depositPercentage     Decimal? @db.Decimal(5, 2)
  platformFeePercentage Decimal? @db.Decimal(5, 2)

  /// ISO 4217 code covering all three amounts above. One field rather than
  /// three: a deposit, the fee taken from it, and the remainder are by
  /// construction the same currency, so separate fields could only ever
  /// disagree by accident.
  currency String @default("USD")

  // ---- Deposit payment ----
  //
  // The provider's own reference for the in-flight request-to-pay, used to poll
  // its outcome. Null when no payment has been started, and CLEARED on failure
  // so the customer can initiate a fresh attempt — a failed reference is not
  // retryable at the provider, so keeping it would strand the appointment.
  paymentProviderReferenceId String?
  paymentInitiatedAt         DateTime?

  /// What was actually sent to the provider, and the rate used to get there.
  ///
  /// Kept ALONGSIDE the USD amounts rather than replacing them. Reconciliation
  /// needs both numbers: when the provider's statement shows a figure that does
  /// not match our USD ledger, the only way to explain the difference rather
  /// than merely observe it is to have recorded the converted amount and the
  /// rate that produced it. Storing just one side makes a discrepancy
  /// permanently unexplainable.
  ///
  /// Null until a payment is initiated.
  providerCurrency            String?
  providerCurrencyAmountCents Int?
  exchangeRateUsed            Decimal? @db.Decimal(18, 8)

  // ---- Arrival verification ----
  //
  // The customer receives a 6-digit code by email; the business enters it to
  // prove the customer actually turned up. Bcrypt-hashed exactly like OTP
  // codes — the raw code is never stored.
  verificationCodeHash String?
  verificationAttempts Int       @default(0)
  verifiedAt           DateTime?

  // Transition timestamps. Kept separate from updatedAt so the auto-transition
  // job, and any later audit, can tell when each clock actually started.
  completedAt DateTime?
  cancelledAt DateTime?
  noShowAt    DateTime?

  // ---- Who cancelled, and why (§33) ----
  //
  // §25's refund policy turns on WHICH party called an appointment off, and
  // until these existed nothing recorded it: cancel() derived the actor to
  // write a notification sentence and then threw it away.
  //
  // Two fields, deliberately not one:
  //
  //   cancelledBy       — the party who bears responsibility, which is what
  //                       decides the money outcome.
  //   cancelledByUserId — who physically performed the action.
  //
  // Usually the same person, and deliberately not always. When an admin
  // resolves a dispute by reclassifying an appointment as business-cancelled,
  // cancelledBy is BUSINESS while cancelledByUserId is the admin, and
  // cancellationTicketId links the ticket that says why. Collapsing them would
  // force a second refund path for admin-resolved cancellations.
  //
  // Null for the expiry sweep, which has no acting user.
  cancelledBy       CancelledBy?
  cancelledByUserId String?
  cancelledByUser   User?        @relation("CancelledAppointments", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  /// Required when a business cancels, optional when a customer does, null for
  /// the sweep. A business cancellation costs the business money under §25, so
  /// it should be a deliberate act with a stated reason.
  cancellationReason String?

  /// Set when the cancellation came out of a support ticket rather than the
  /// self-service route. It is what makes an admin reclassification auditable.
  cancellationTicketId String?
  cancellationTicket   Ticket? @relation("CancellationTickets", fields: [cancellationTicketId], references: [id], onDelete: SetNull)

  /// When the deposit was confirmed by the provider. Set once, never cleared.
  ///
  /// Status cannot answer "was this ever paid?" because later transitions
  /// destroy the evidence: once an appointment is CANCELLED, nothing remains to
  /// distinguish an expired unpaid hold from a deposit that was taken and then
  /// called off. That is why the collected-deposits figure was only ever a
  /// floor (§29.1). A timestamp survives every subsequent transition.
  depositPaidAt DateTime?

  /// Set when the pre-appointment reminder goes out, so the sweep never sends
  /// the same reminder twice. A timestamp rather than a boolean so it is
  /// visible *when* the customer was reminded.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  thread        Thread?
  // Named because there are now TWO relations to Ticket: tickets raised ABOUT
  // this appointment, and the single ticket a cancellation came out of.
  tickets       Ticket[]            @relation("TicketAppointment")
  adjustments   BillingAdjustment[]
  review        Review?

  // Availability counts overlapping appointments at one location for one day.
  @@index([locationId, startTime])
  // The customer's own list, newest first.
  @@index([customerId, startTime])
  // Drives the auto-transition sweep, which scans by status and end time.
  @@index([status, endTime])
  // Drives the payment-confirmation poll and the PENDING_PAYMENT expiry sweep,
  // both of which scan by status and creation time.
  @@index([status, createdAt])
  @@map("appointments")
}

/// A message sent to one person about one event.
///
/// Stored rather than fire-and-forget for two reasons. It is the audit trail —
/// when a business says nobody told them about a booking, the row either exists
/// or it does not — and it is the in-app inbox, so a frontend can list
/// notifications later without a schema change.
model Notification {
  id String @id @default(uuid())

  /// Who it is for. Cascades: a deleted account's notifications are of no use
  /// to anyone, unlike an appointment, which is a financial record.
  recipientId String
  recipient   User   @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel @default(EMAIL)
  status  NotificationStatus  @default(PENDING)

  /// Rendered at send time and kept, so the inbox shows exactly what was sent
  /// rather than re-rendering against data that has since changed — a
  /// cancelled appointment must not rewrite the message that announced it.
  subject String
  body    String

  /// The appointment this concerns, when it concerns one. SetNull rather than
  /// Cascade: the notification is evidence that something was communicated and
  /// should outlive the record it referred to.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// Null until the recipient marks it read. Not a boolean, so "when" is
  /// answerable later without another column.
  readAt DateTime?

  sentAt       DateTime?
  failureCount Int       @default(0)
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The inbox query: one recipient, newest first.
  @@index([recipientId, createdAt])
  /// The retry sweep: everything not yet delivered.
  @@index([status])
  @@map("notifications")
}

// ---------- Chat ----------

/// A conversation between one customer and one business.
///
/// ONE model covers both cases, distinguished only by whether appointmentId is
/// set. Two tables would duplicate every message, read-state and permission
/// rule for a distinction that matters only at creation time.
///
/// - appointmentId SET  — tied to a booking, created automatically with it.
/// - appointmentId NULL — a pre-booking inquiry, created on demand, exactly
///   one per (customer, business) pair and reused forever after.
model Thread {
  id String @id @default(uuid())

  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  customerId String
  customer   User   @relation("CustomerThreads", fields: [customerId], references: [id], onDelete: Cascade)

  /// Unique when set, which a plain @unique gives us: Postgres treats NULLs as
  /// distinct, so any number of inquiry threads coexist while a booking can
  /// have at most one thread.
  ///
  /// Cascade: an appointment-scoped thread has no meaning without its
  /// appointment. Inquiry threads are unaffected — they have no appointment.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Denormalised so the thread list can sort by recency without joining and
  /// aggregating messages on every request. Updated on each new message.
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages   Message[]
  readStates ThreadReadState[]

  /// "One inquiry thread per customer-business pair" cannot be expressed here:
  /// it must apply only WHERE appointmentId IS NULL, and Prisma's DSL has no
  /// partial index. It is created in the migration as
  /// "threads_inquiry_customer_business_key" — the same pattern, and the same
  /// caveat, as BusinessMembership's active-only index (§15.3).
  @@index([businessProfileId, lastMessageAt])
  @@index([customerId, lastMessageAt])
  @@map("threads")
}

/// One message. Text, a photo, or both — never neither.
model Message {
  id       String @id @default(uuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  /// Both nullable, but a message with neither is rejected in the service. A
  /// CHECK constraint enforces the same rule in the database, since an empty
  /// message is meaningless however it is inserted.
  body     String?
  photoUrl String?

  createdAt DateTime @default(now())

  /// The message list: one thread, chronological.
  @@index([threadId, createdAt])
  @@map("messages")
}

/// Per-person read position within a thread.
///
/// One row per (thread, user) rather than a single flag on Thread, because a
/// business has several members (§14) and an owner reading a message must not
/// silently mark it read for the staff member who actually has to answer it.
model ThreadReadState {
  id       String @id @default(uuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ThreadReadStates", fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime

  /// When this person was last emailed about this thread. Lives here because
  /// the key is identical — per thread, per person — and a second table would
  /// duplicate it for no gain. Drives the notification debounce, the same
  /// claim-a-timestamp trick used for appointment reminders (§20.5).
  lastNotifiedAt DateTime?

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_read_states")
}

// ---------- Support tickets ----------
//
// Deliberately NOT built on Chat's Thread/Message (§21). The participants are
// different — a reporter and the platform's admins, rather than a customer and
// a business — and tickets carry status, assignment and resolution that a chat
// thread has no notion of. These tables borrow Chat's proven shapes without
// sharing its models.

/// A problem reported to the platform admins.
model Ticket {
  id String @id @default(uuid())

  /// Human-quotable in an email or a phone call, e.g. "TKT-000123". Generated
  /// from a Postgres sequence inside the creating transaction, so concurrent
  /// creates cannot collide the way a count-and-increment read would.
  reference String @unique

  reporterId   String
  reporter     User         @relation("ReportedTickets", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterType ReporterType

  /// Set when reporterType = BUSINESS. It is what lets every member of that
  /// business see the ticket, not only the person who raised it.
  businessId      String?
  businessProfile BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Optional — a ticket may be general ("I cannot log in"). When present, the
  /// reporter is verified to be a party to it at creation.
  ///
  /// Named because there are now two Appointment<->Ticket relations; see
  /// citedByCancellations below.
  appointmentId String?
  appointment   Appointment? @relation("TicketAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)

  category TicketCategory
  subject  String
  status   TicketStatus   @default(OPEN)

  assignedAdminId String?
  assignedAdmin   User?   @relation("AssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  /// Required to move IN_PROGRESS -> RESOLVED. A resolution with no
  /// explanation is not a resolution the reporter can act on.
  resolutionNote String?

  resolvedAt  DateTime?
  closedAt    DateTime?
  reopenedAt  DateTime?
  reopenCount Int       @default(0)

  /// Denormalised so the admin queue sorts by recency without aggregating
  /// messages on every request — the same trick Thread.lastMessageAt uses.
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    TicketMessage[]
  attachments TicketAttachment[]
  adjustments BillingAdjustment[]

  /// Cancellations that cite this ticket as their reason.
  citedByCancellations Appointment[] @relation("CancellationTickets")

  /// The admin queue: open work, most recently active first.
  @@index([status, lastMessageAt])
  @@index([reporterId])
  @@index([businessId])
  @@map("tickets")
}

model TicketMessage {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId   String
  author     User             @relation("TicketMessages", fields: [authorId], references: [id], onDelete: Cascade)
  authorType TicketAuthorType

  body String

  /// An admin-only note. Filtered out in the QUERY for every reporter-facing
  /// read, never removed after the fact — a filter applied late is a filter
  /// someone eventually forgets to apply.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Null when attached to the ticket itself rather than to a later message.
  ticketMessageId String?
  ticketMessage   TicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)

  url       String
  mimeType  String
  sizeBytes Int

  uploadedById String
  uploadedBy   User   @relation("TicketAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

/// A fee credit or charge an admin recorded while resolving a ticket.
///
/// NOTE: this table records ADMIN INTENT only. Nothing writes to it
/// automatically and nothing consumes it — no money moves because a row exists
/// here. The platform fee is taken from the customer's deposit at booking
/// (DECISIONS.md §2, §16.3), so settlement means reversing that charge at the
/// payment provider, not adjusting an invoice. See §25.
model BillingAdjustment {
  id String @id @default(uuid())

  businessId      String
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  type   BillingAdjustmentType
  amount Decimal               @db.Decimal(12, 2)
  reason String

  /// When the money actually moved, and the provider's reference for it.
  /// Both null until something settles this adjustment — nothing does yet, so
  /// every row is unsettled by definition. They exist so that when refunds are
  /// built, a settled adjustment is distinguishable from an outstanding one
  /// without a second table.
  settledAt     DateTime?
  settlementRef String?

  createdById String
  createdBy   User   @relation("CreatedAdjustments", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// The query a future settlement run makes: this business's outstanding rows.
  @@index([businessId, settledAt])
  @@map("billing_adjustments")
}

// ---------- Reviews ----------

/// A customer's review of one appointment, scoped to the LOCATION it happened
/// at rather than to the business.
///
/// Per-location is the product decision: a chain's well-run branch should not
/// be dragged down by a badly-run one, and a customer choosing between two
/// branches is choosing between those branches, not between companies.
model Review {
  id String @id @default(uuid())

  /// One review per completed appointment, enforced HERE rather than by a
  /// read-then-write check — two concurrent submissions both pass a read and
  /// only the unique index stops the second.
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  customerId String
  customer   User   @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)

  /// Both denormalised from the appointment at creation and never accepted
  /// from the request: a review must describe where the service actually
  /// happened, not where the reviewer says it did.
  businessId      String
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  rating  Int // 1-5, validated in the DTO and by a CHECK constraint
  comment String?

  /// Set on any customer edit. Surfaced in responses, because a rating that
  /// changed after a business replied is context the reader needs.
  editedAt DateTime?

  // ---- Moderation ----
  //
  // Soft-hide: hidden reviews leave public listings and aggregates but stay in
  // the table. A hidden review is usually the evidence in the ticket that got
  // it hidden, so deleting it destroys the record of why.
  hiddenAt     DateTime?
  hiddenReason String?
  hiddenById   String?
  hiddenBy     User?     @relation("HiddenReviews", fields: [hiddenById], references: [id], onDelete: SetNull)

  // ---- Business response ----
  //
  // Fields on the review rather than a table, because the rule is exactly one
  // response per review and a separate table would imply many.
  responseText     String?
  responseAt       DateTime?
  responseById     String?
  responseBy       User?     @relation("ReviewResponses", fields: [responseById], references: [id], onDelete: SetNull)
  responseEditedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The public listing: one location, visible reviews, newest first.
  @@index([locationId, hiddenAt, createdAt])
  @@index([businessId])
  @@map("reviews")
}

model OtpCode {
  id          String     @id @default(uuid())
  email       String
  codeHash    String // never store the raw code
  purpose     OtpPurpose @default(LOGIN)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // raw refresh token is never stored, only its hash
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

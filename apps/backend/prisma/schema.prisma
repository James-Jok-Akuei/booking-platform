// Prisma schema for the booking platform backend.
// Single database, single backend, role-based access for
// business / customer / admin as agreed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUSINESS
  CUSTOMER
  ADMIN
}

// A business account's approval status.
// New businesses land on PENDING until an admin approves them (see admin portal, later module).
//
// NOTE (approval-status rule): a PENDING business may still complete its entire
// profile — locations, hours, services, gallery. Status gates *visibility*, not
// editing. Only APPROVED businesses should ever surface in public customer-facing
// search/discovery; PENDING / REJECTED / SUSPENDED must be filtered out there.
// That filter is NOT enforced in this module — there are no public discovery
// endpoints yet. It belongs to the customer search module.
enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OtpPurpose {
  LOGIN // covers both signup and login since OTP-only auth treats them the same
}

// Who a person is within a business. Exactly one OWNER per business is an
// invariant enforced in the service layer: OWNER cannot be invited, assigned,
// removed, or demoted, so the founding signup's OWNER is permanent for MVP.
enum BusinessMemberRole {
  OWNER // full control, including membership management
  MANAGER // everything OWNER can do EXCEPT managing members and invitations
  STAFF // read-only for now; gains booking permissions with the Appointment module
}

// Soft-delete state for a membership. Removed rows are kept, never deleted, so
// the record of who had access survives.
enum BusinessMemberStatus {
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Which side of the platform raised a ticket. Derived from the authenticated
/// user's role at creation, never accepted from the request body.
enum ReporterType {
  CUSTOMER
  BUSINESS
}

enum TicketCategory {
  PAYMENT_ISSUE
  APPOINTMENT_DISPUTE
  ACCOUNT_ISSUE
  TECHNICAL_ISSUE
  OTHER
}

/// Lifecycle. Transitions are enforced in one place — see
/// TicketsService.transitionStatus — and anything not in that table throws.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketAuthorType {
  REPORTER
  ADMIN
}

/// What kind of money movement an admin recorded.
///
/// Named for how this platform actually charges (DECISIONS.md §2, §25): the
/// platform fee comes out of the customer's deposit at booking, so there is
/// nothing to "credit" against a future invoice — only a fee already taken that
/// may need refunding, or a gateway cost the business bears.
enum BillingAdjustmentType {
  /// The platform fee taken at booking should go back to the customer.
  /// Recorded when a BUSINESS cancels: the customer is refunded in full.
  FEE_REFUND

  /// The payment gateway's own charge (1-2%) on a refunded transaction, borne
  /// by the business that cancelled.
  GATEWAY_FEE_DEBIT
}

/// What happened. One value per notifiable event, so a recipient's history is
/// queryable by kind ("show me every booking I was told about") rather than by
/// parsing rendered copy.
enum NotificationType {
  APPOINTMENT_BOOKED // a customer booked; the business is told
  DEPOSIT_CONFIRMED // deposit landed; both sides are told
  APPOINTMENT_CANCELLED // called off by either side, or expired unpaid
  APPOINTMENT_NO_SHOW // business recorded a no-show
  DEPOSIT_FAILED // the payment attempt failed; the customer may retry
  APPOINTMENT_REMINDER // sent ahead of the appointment
  BUSINESS_INVITATION // someone was invited to join a business
  NEW_MESSAGE // a chat message arrived; debounced, see DECISIONS.md
  TICKET_CREATED // a support ticket was raised; admins are told
  TICKET_MESSAGE // a reply on a ticket; never sent for internal notes
  TICKET_STATUS_CHANGED // the ticket moved through its lifecycle
  REVIEW_CREATED // a customer reviewed a location; the business is told
  REVIEW_RESPONSE // the business replied to a review
  REVIEW_HIDDEN // an admin hid a review; both sides are told
  DISPLAY_NAME_CLEARED // an admin cleared a customer's review display name
  EXCHANGE_RATE_STALE // the manual USD->provider rate has not been updated
  BUSINESS_APPROVED // an admin approved the business; it is now public
  BUSINESS_REJECTED // an admin rejected the application, with a reason
  BUSINESS_SUSPENDED // an admin suspended the business, with a reason
  BUSINESS_REINSTATED // a suspended business was restored
  PAYOUT_DESTINATION_SUBMITTED // a business submitted a payout number; admins check it
  PAYOUT_DESTINATION_VERIFIED // the number was verified; payouts can flow
  PAYOUT_DESTINATION_REJECTED // an admin refused it, with a reason
  PAYMENT_PROVIDER_MISCONFIGURED // the platform cannot take payments; admins only
  APPOINTMENT_MANUALLY_VERIFIED // a business verified an arrival without the code; admins only
}

/// How it was delivered. EMAIL is the only implementation today; SMS exists in
/// the enum because South Sudan runs on SMS far more than email, and the
/// channel abstraction is built so adding it touches no calling code.
enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING // created, not yet dispatched
  SENT
  FAILED // dispatch failed; retried by the sweep
}

// Gallery media kind. Only PHOTO is produced today — the enum exists so VIDEO
// can be added later without a destructive column-type migration.
enum MediaType {
  PHOTO
}

// Uploaded media is moderated: it lands PENDING and an admin approves or rejects
// it (admin portal, later module). Mirrors BusinessStatus in spirit.
enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The appointment lifecycle. Transitions are enforced in AppointmentsService;
/// see DECISIONS.md for the state machine and why COMPLETED has no bypass.
enum AppointmentStatus {
  PENDING_PAYMENT // created, deposit not yet paid
  BOOKED // deposit paid, slot held
  IN_PROGRESS // customer arrived and their code was verified
  COMPLETED // service delivered
  CANCELLED // called off from PENDING_PAYMENT or BOOKED
  NO_SHOW // never verified, and the window has passed
}

/// What a ledger entry records. The sign lives on the amount, not here: an
/// entry's type says what happened, and `amountMinor` says which way the money
/// went from the BUSINESS's point of view.
/// Where a payout has got to. There is no IN_PROGRESS: the platform has no
/// transfer API to be in the middle of (§35.1), so a payout is either awaiting
/// a human, done, or failed.
enum PayoutStatus {
  PENDING // created by a run; nothing has been sent
  PROCESSING // handed to the operator, outcome not yet known (§64.3)
  PAID
  FAILED
}

enum LedgerEntryType {
  /// A customer's deposit landed. Positive.
  DEPOSIT_RECEIVED

  /// The platform's cut of that deposit. Negative.
  PLATFORM_FEE

  /// A deposit given back to the customer, because the business cancelled.
  /// Negative.
  DEPOSIT_REFUND

  /// The platform fee handed back with it, so the customer is made whole.
  /// Positive — it offsets the PLATFORM_FEE that was taken at booking.
  PLATFORM_FEE_REVERSAL

  /// What the payment gateway charged to process the refund, borne by the
  /// business that caused it (§25). Negative.
  GATEWAY_FEE_DEBIT

  /// A manual correction, from an executed BillingAdjustment. Signed by the
  /// adjustment's own type.
  ADJUSTMENT
}

/// Where a business's payouts are sent. One provider today; the enum exists so
/// adding a second is a migration rather than a reinterpretation of a string.
/// A mobile money operator, in EITHER direction (§57.1).
///
/// One enum rather than two. Collections and disbursements move money opposite
/// ways, but "which company" is the same question and the same set of answers —
/// two parallel enums would drift the first time an operator was added to one
/// and not the other.
///
/// Renamed from `PayoutProvider`, which named the direction rather than the
/// thing: it was only ever about payouts because payouts were the only place
/// the operator was recorded. Since §57 a payment records it too.
enum MobileMoneyProvider {
  MTN_MOMO
  AIRTEL_MONEY
}

enum PayoutDestinationStatus {
  UNVERIFIED // submitted, not yet checked. BLOCKS payouts (§48.3).
  VERIFIED // money may be sent here
  REJECTED // an admin refused it, with a reason
  SUPERSEDED // replaced by a later submission; kept as history
}

/// HOW a destination was verified.
///
/// Null until it is. `ADMIN` today; an OTP path later sets `OTP` with
/// `verifiedById` null, because the number's holder is not a user in this
/// system. A row verified by an administrator and one verified by the person
/// holding the SIM are different facts and must not look identical in the
/// table — recording the method now means the OTP path adds rows rather than
/// forcing a reinterpretation of old ones.
enum PayoutVerificationMethod {
  ADMIN
  OTP
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The name shown beside this customer's reviews, on the User rather than on
  /// each Review: one source of truth means changing it changes every review at
  /// once, instead of leaving three different names across three reviews.
  ///
  /// Nullable, no backfill, and null is NOT the string "Anonymous". Readers
  /// render null as "Anonymous", which keeps a customer who deliberately typed
  /// "Anonymous" distinguishable from one who never supplied a name at all.
  /// Cleared back to null by admin moderation; see §31.
  displayName String?

  /// This person's picture (§124). Uploaded, never a link — the same rule as a
  /// business logo (§88): a URL somebody else controls can become anything after
  /// it has been approved.
  ///
  /// Shown to them, and to nobody else. A customer's face is not part of a
  /// booking: a shop needs a name to call out and an arrival code, and §112.1
  /// had just finished removing an email from a chat message for the same
  /// reason.
  imageUrl String?

  /// When this person closed their own account (§119). Null means open.
  ///
  /// A SOFT close, and it has to be: deleting the row cascades to every
  /// appointment they ever made, which cascades to their reviews and threads and
  /// leaves `ledger_entries.appointmentId` NULL — money the platform recorded
  /// owing to a business, with no record of what it was for. §89 found the same
  /// shape for branches and answered it the same way.
  ///
  /// The row survives; the person does not. Closing clears `displayName` and
  /// replaces `email` with an address nobody holds, so the reviews a business
  /// depends on keep their shape while the identity behind them is gone.
  closedAt DateTime?

  // A business user reaches their BusinessProfile through BusinessMembership,
  // never directly.
  //
  // A LIST, not a single row: someone who leaves a business keeps that
  // membership as a REMOVED row and may later join another, so the history
  // accumulates. At most one of these is ACTIVE at a time — enforced by a
  // partial unique index; see BusinessMembership.userId. Callers wanting "the
  // business this person works in" must filter to ACTIVE rather than taking
  // the first row.
  businessMemberships BusinessMembership[]

  // Invitations this user has sent. Only OWNERs can send them.
  sentInvitations BusinessInvitation[] @relation("InvitedBy")

  /// Exactly one administrator holds this, and only they may invite or remove
  /// other administrators (§99). The same shape as a business OWNER: it is the
  /// line between "can run the platform" and "can decide who runs it".
  ///
  /// Uniqueness is a partial index in the migration, not a column constraint —
  /// Postgres treats a plain unique on a boolean as "only one row may be
  /// false" too, which would allow a single administrator and nobody else.
  isPrimaryAdmin Boolean @default(false)

  sentAdminInvitations AdminInvitation[] @relation("AdminInvitedBy")

  // Appointments booked by this user. Only populated when role = CUSTOMER.
  appointments         Appointment[] @relation("CustomerAppointments")
  /// Appointments this user verified the arrival for, as a business member
  /// (§54.3). Separate from `appointments`, which is the customer side.
  verifiedAppointments Appointment[] @relation("VerifiedAppointments")

  /// Appointments this user cancelled — as a customer, as a business member, or
  /// as an admin acting on a dispute. Who ACTED; Appointment.cancelledBy says
  /// who bears responsibility, which is a different question.
  cancelledAppointments Appointment[] @relation("CancelledAppointments")

  notifications Notification[] @relation("UserNotifications")

  threads          Thread[]          @relation("CustomerThreads")
  sentMessages     Message[]         @relation("SentMessages")
  threadReadStates ThreadReadState[] @relation("ThreadReadStates")

  reportedTickets    Ticket[]            @relation("ReportedTickets")
  assignedTickets    Ticket[]            @relation("AssignedTickets")
  ticketMessages     TicketMessage[]     @relation("TicketMessages")
  ticketAttachments  TicketAttachment[]  @relation("TicketAttachments")
  createdAdjustments BillingAdjustment[] @relation("CreatedAdjustments")

  favourites              Favourite[]          @relation("CustomerFavourites")
  serviceFavourites       ServiceFavourite[]   @relation("CustomerServiceFavourites")
  savedPaymentNumbers     SavedPaymentNumber[] @relation("SavedPaymentNumbers")
  createdServiceDrafts    ServiceDraft[]       @relation("CreatedServiceDrafts")
  legalAcceptances        LegalAcceptance[]    @relation("LegalAcceptances")
  publishedLegalDocuments LegalDocument[]      @relation("PublishedLegalDocuments")
  reviews                 Review[]             @relation("CustomerReviews")
  hiddenReviews           Review[]             @relation("HiddenReviews")
  reviewResponses         Review[]             @relation("ReviewResponses")

  /// The platform settings row, when this user was the last to set its
  /// exchange rate. A list because Prisma models it as one, but there is a
  /// single settings row.
  exchangeRateUpdates PlatformSetting[] @relation("ExchangeRateUpdates")

  /// Businesses whose status this user last changed. The admin moderation trail.
  businessStatusChanges BusinessProfile[] @relation("BusinessStatusChanges")

  submittedPayoutDestinations PayoutDestination[] @relation("SubmittedPayoutDestinations")
  verifiedPayoutDestinations  PayoutDestination[] @relation("VerifiedPayoutDestinations")

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]

  // ---- Emails about services nearby (§140). All null until they say yes. ----
  /// WHEN the customer agreed to marketing email. Null means they have not.
  offersOptInAt    DateTime?
  /// Where "near" is measured from: a district they chose, never a GPS fix.
  homeDistrictId   String?
  homeDistrict     District? @relation("HomeDistrict", fields: [homeDistrictId], references: [id], onDelete: SetNull)
  /// The customer's exact spot, if they chose to give it (§169). Both or neither.
  homeLatitude     Float?
  homeLongitude    Float?
  /// What the phone called that spot — a street or an area — shown back to them.
  homeLabel        String?
  /// Carried by the unsubscribe link, so it works without signing in.
  offersToken      String?   @unique
  offersLastSentAt DateTime?

  @@index([homeDistrictId, offersOptInAt])
  @@map("users")
}

model BusinessProfile {
  id String @id @default(uuid())

  // No userId column. A business is reached through BusinessMembership, which
  // is what allows more than one person to work in it.

  name        String? // business display name, set during onboarding
  description String?
  phone       String?

  // Taxonomy. Both nullable: the profile row is created at signup, before the
  // business has picked anything. SetNull on delete so retiring a category
  // never cascades away a business account.
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  // Business-level branding. Per-location photos live in LocationMedia instead.
  logoUrl       String?
  coverImageUrl String?

  status BusinessStatus @default(PENDING)

  /// Why the business is in its CURRENT status — the rejection reason, the
  /// suspension reason, or null.
  ///
  /// Replaces `rejectionReason` (§42.2): one field describing whichever state
  /// the row is actually in, rather than a field that could only ever describe
  /// one of four. Cleared on approval and reinstatement, because a stale reason
  /// sitting beside an APPROVED business reads as an accusation.
  statusReason      String?
  statusChangedAt   DateTime?
  statusChangedById String?
  statusChangedBy   User?     @relation("BusinessStatusChanges", fields: [statusChangedById], references: [id], onDelete: SetNull)

  /// When the business paused ITSELF (§119). Null means trading.
  ///
  /// Deliberately not `status: SUSPENDED`. That is a moderation state an admin
  /// puts a business into, with a reason the business is told — reusing it for
  /// "we are closed for a month" would make a holiday indistinguishable from a
  /// sanction in every admin listing.
  ///
  /// Reversible by the business, with nothing lost: bookings already made still
  /// happen, money owed is still paid out. It only stops NEW ones and takes the
  /// shop out of search.
  pausedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations   Location[]
  services    Service[]
  members     BusinessMembership[]
  invitations BusinessInvitation[]
  threads     Thread[]
  tickets     Ticket[]
  adjustments BillingAdjustment[]
  reviews     Review[]

  ledgerEntries      LedgerEntry[]
  payouts            Payout[]
  payoutDestinations PayoutDestination[]

  serviceDrafts ServiceDraft[]

  @@index([categoryId])
  @@index([status])
  @@map("business_profiles")
}

// ---------- Taxonomy ----------
// Seeded from prisma/seed.ts, not from a migration, so the MVP taxonomy stays
// re-runnable and editable without writing a new migration each time.

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  icon        String? // icon key/emoji for the frontends; not a URL
  description String?

  /// Whether a business may CHOOSE this category (§98).
  ///
  /// The platform ships more of the taxonomy than it wants to open at once —
  /// start with beauty and dining, add the rest as there is someone to serve
  /// them. Defaults to true so every seeded category keeps behaving exactly as
  /// it did; the admin turns off what is not wanted.
  ///
  /// It gates the PICKER, never discovery. A business already in a category
  /// that is switched off keeps its listing: dropping somebody's shop out of
  /// search because an admin tidied the taxonomy would be a silent punishment
  /// for a decision they did not make.
  isLive Boolean @default(true)

  subcategories Subcategory[]
  businesses    BusinessProfile[]

  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String

  /// Whether a business may choose this type, exactly as Category.isLive (§100).
  ///
  /// Independent of the parent's flag in storage and ANDed with it on read: a
  /// live type inside a hidden category is still not offered. Copying the
  /// parent's state down would mean rewriting every child whenever a category
  /// is toggled, and the two would drift the first time that half-failed.
  isLive Boolean @default(true)

  businesses BusinessProfile[]

  // Unique per parent, not globally: "Bridal Makeup" under Beauty and a
  // same-named entry under a future category must not collide.
  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("subcategories")
}

// ---------- Locations ----------

model Location {
  id         String          @id @default(uuid())
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String // e.g. "Juba Town Branch"
  address String

  // Nullable: many businesses onboard with a street address long before anyone
  // pins exact coordinates. Distance search must tolerate their absence.
  latitude  Float?
  longitude Float?

  // Optional per-location override of BusinessProfile.phone.
  phone String?

  // How many appointments this location can run at the same instant — four
  // chairs, three treatment rooms, one photographer. Defaults to 1, which is
  // exactly the behaviour every existing location had before this column
  // existed. Answers the four-chair-salon limitation noted in DECISIONS.md.
  //
  // Capacity is per LOCATION, not per staff member: there is still no staff
  // model, so this counts units of simultaneous service, not people.
  capacity Int @default(1)

  /// Denormalised review aggregates, recalculated inside the same transaction
  /// as any review change. Location browsing is a hot read path and must never
  /// run AVG() across the review table to render a star rating.
  ///
  /// Both count NON-HIDDEN reviews only. ratingAvg is null until the first
  /// review lands — meaningfully different from 0, which would read as "rated
  /// zero" rather than "not yet rated".
  ratingAvg   Decimal? @db.Decimal(3, 2)
  ratingCount Int      @default(0)

  /// The cheapest ACTIVE service price of the owning business, in cents.
  ///
  /// Denormalised exactly like ratingAvg/ratingCount above: maintained on write,
  /// never computed on read. It is what lets `sort=price` and `maxPriceMinor`
  /// agree on one number and order across pages — a value derived at read time
  /// can filter a page but cannot order the rows that were never fetched (§44).
  ///
  /// Business-scoped, because services are (§10.2): one service write updates
  /// every location that business owns.
  ///
  /// NULL means the business has no active services. That is not the same as
  /// "no results" — such a location still browses, and sorts last under
  /// sort=price.
  fromPriceMinor Int?

  /// Where this branch is, administratively (§104).
  ///
  /// On the LOCATION, not the business: a business with branches in Kigali and
  /// Musanze is in two provinces, and that is a fact about its branches. The
  /// province is reached through the district rather than stored twice — a
  /// district cannot move province, and two columns that can disagree will.
  ///
  /// Nullable because every existing branch predates this and a required
  /// column would have made them unsaveable. A branch without one is simply
  /// not findable by place, which is a reason to set it rather than a failure.
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: Restrict)

  /// Soft-delete flag, matching Service.isActive (§89).
  ///
  /// A branch is never hard-deleted. It used to be, and the comment on that
  /// code said "a location has no historical appointment references to
  /// preserve yet" — which stopped being true the moment Appointment grew a
  /// locationId. Closing a branch must not erase the bookings that happened
  /// there, the reviews customers left about it, or the appointments that
  /// explain ledger entries.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hours              LocationHours[]
  reviews            Review[]
  media              LocationMedia[]
  scheduleExceptions LocationScheduleException[]
  timeBlocks         LocationTimeBlock[]
  appointments       Appointment[]

  /// Which services this branch offers, and at what price (§72).
  services ServiceLocation[]

  favourites        Favourite[]        @relation("LocationFavourites")
  serviceFavourites ServiceFavourite[] @relation("LocationServiceFavourites")

  @@index([businessId])
  /// Branch lists and discovery filter on this constantly (§89).
  @@index([businessId, isActive])
  /// Place filtering, which every customer search may use (§104).
  @@index([districtId])
  /// The bounding-box prefilter behind distance search (§43.5). Postgres can
  /// use it to cut the candidate set before any haversine is computed.
  @@index([latitude, longitude])
  /// Serves ORDER BY fromPriceMinor and the maxPriceMinor filter (§44).
  @@index([fromPriceMinor])
  @@map("locations")
}

model LocationHours {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday ... 6 = Saturday (JS Date.getDay() convention)
  openTime  String // "HH:mm", 24-hour
  closeTime String // "HH:mm", 24-hour
  isClosed  Boolean @default(false) // true = shut all day; open/close ignored

  // One row per day per location — the hours endpoint replaces the whole week.
  @@unique([locationId, dayOfWeek])
  @@index([locationId])
  @@map("location_hours")
}

// ---------- Services ----------

/// A service offered at one branch, at that branch's price (§72).
///
/// The row carries BOTH the price and whether the branch is currently selling
/// it (`isOffered`, §74). It is never deleted by withdrawing a service, because
/// the price is worth keeping through a pause.
///
/// Removing a link never touches history. An appointment snapshots the price it
/// was booked at (§30), so a past booking stays reconstructable at a branch that
/// no longer offers the service.
model ServiceLocation {
  id String @id @default(uuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// Minor units of the service's currency: what a customer pays at THIS branch.
  priceMinor Int

  /// Whether the branch is currently selling it (§74).
  ///
  /// A TOGGLE, not a deletion. A barber on leave for a month, a machine out of
  /// action, a seasonal treatment — these are pauses, and the row is kept so
  /// the price survives them. Deleting meant retyping the price to resume,
  /// which is data loss dressed up as a clean model.
  ///
  /// Distinct from `Service.isActive`, which is "we have stopped doing this at
  /// all, everywhere". This is "not here, for now".
  isOffered Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One offer per service per branch. Two rows would be two prices with no
  /// rule for which wins.
  @@unique([serviceId, locationId])
  /// Serves "what is this branch selling right now", the discovery read.
  @@index([locationId, isOffered])
  @@map("service_locations")
}

/// What a quantity of a service means (§136).
enum QuantityMode {
  /// One per booking. Every service before §136.
  SINGLE
  /// Several PEOPLE: each needs a place in the shop.
  PEOPLE
  /// Several of the thing for one customer: only the price multiplies.
  UNITS
}

model Service {
  id         String          @id @default(uuid())
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Money is stored as integer cents, never a float. Binary floating point
  // cannot represent most decimal money values exactly, and the deposit /
  // platform-fee split (see DECISIONS.md §2) does arithmetic on these amounts.
  /// Price lives on ServiceLocation, not here (§72).
  ///
  /// A service is WHAT the business does — a haircut, a thirty-minute massage —
  /// and what it costs is a property of the branch doing it. A city-centre shop
  /// charges more than a suburban one for the same work, and before §72 the
  /// model could not express that: one price was shared by every location, so a
  /// business with two prices had to invent two services.
  ///
  /// A service therefore has no price until it is offered somewhere, which makes
  /// "offered nowhere" an honest, visible state rather than a bookable service
  /// no customer can reach.
  durationMinutes Int

  /// ISO 4217 code for priceMinor. Always "USD" today — the platform's internal
  /// unit of account (see DECISIONS.md).
  ///
  /// Stored explicitly even though every row reads the same value, so that a
  /// future multi-currency world never has to GUESS what an old row meant.
  /// An unlabelled amount is only unambiguous while exactly one currency has
  /// ever existed, and that property is impossible to restore afterwards.
  currency String

  // Share of priceMinor the customer pays up front to hold the slot.
  //
  // Must be >= the live PlatformSetting.platformFeePercentage, validated on
  // every write. Both percentages apply to the same base (the service price),
  // so that floor is precisely what guarantees the platform fee never exceeds
  // the deposit it is taken from — i.e. businessAmountMinor can never go
  // negative. Decimal, never Float: this multiplies money.
  depositPercentage Decimal @default(10.00) @db.Decimal(5, 2)

  /// Whether one booking may be for more than one, and what "more" means (§136).
  quantityMode QuantityMode @default(SINGLE)
  /// The most one booking may ask for. 1 when SINGLE, 2–20 otherwise (a CHECK
  /// constraint holds the two together).
  maxQuantity  Int          @default(1)

  // Soft-delete flag. Services are never hard-deleted: appointments booked in
  // the future will reference serviceId, and those records must still resolve
  // to a real name/price after the business stops offering the service.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  /// Where this service is offered, and for how much (§72).

  locations ServiceLocation[]

  /// Photos of the service itself (§132), capped in ServiceImagesService.
  images     ServiceMedia[]
  favourites ServiceFavourite[] @relation("ServiceFavourites")

  @@index([businessId])
  @@map("services")
}

// ---------- Gallery ----------

model LocationMedia {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  type   MediaType   @default(PHOTO)
  url    String
  status MediaStatus @default(PENDING)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([locationId])
  @@map("location_media")
}

/// Photos of ONE SERVICE, shown to a customer choosing between services (§132).
///
/// Hangs off `Service`, not off `ServiceLocation`: a haircut looks the same at
/// every branch and only its PRICE differs, so putting photos on the per-branch
/// join would make a business upload the same eleven pictures once per branch.
///
/// A separate table from `location_media` for the reason tickets are separate
/// from chat: the columns are alike, the subject is not, and one shared table
/// would put a "which kind is this" predicate in every query.
model ServiceMedia {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  type MediaType @default(PHOTO)
  url  String

  /// Same unmoderated reality as `location_media` (§132.2): nothing sets this
  /// and nothing reads it, so a photo is visible as soon as it is uploaded. The
  /// column exists so that if moderation is ever built it is built once, for
  /// both tables, rather than bolted onto one.
  status MediaStatus @default(PENDING)

  /// Lowest first. The first photo is the one a customer sees in a list.
  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([serviceId, displayOrder])
  @@map("service_media")
}

// ---------- Availability ----------
//
// Availability is NOT stored. It is computed live on every request from three
// inputs: the weekly template (LocationHours), the date-specific exceptions and
// blocks below, and existing appointments. There is deliberately no table of
// pre-generated future slots — see DECISIONS.md for why.

/// A date-specific override of the weekly template. Either closes the day
/// outright or replaces that date's opening hours.
model LocationScheduleException {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // A calendar day, not an instant — @db.Date so Postgres stores no time or
  // offset. "Closed on 2026-12-25" is true regardless of what hour it is.
  date DateTime @db.Date

  isClosed Boolean @default(false)

  // Set only when isClosed = false and this date's hours differ from the
  // weekly template. Both null means "closed", both set means "open, but with
  // these hours instead". "HH:mm", 24-hour, same convention as LocationHours.
  customOpenTime  String?
  customCloseTime String?

  reason String? // e.g. "Public holiday", "Staff training"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One exception per location per date — a date cannot be both closed and
  // open-with-custom-hours. Enforced in the database, not just the service.
  @@unique([locationId, date])
  @@index([locationId, date])
  @@map("location_schedule_exceptions")
}

/// A partial-day manual block, e.g. "2pm-4pm, owner unavailable". Subtracts
/// from availability exactly the way a booked appointment does, without
/// closing the whole day. Many blocks per location per date are allowed.
model LocationTimeBlock {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  reason String?

  createdAt DateTime @default(now())

  @@index([locationId, date])
  @@map("location_time_blocks")
}

// ---------- Business membership ----------

/// Links a person to the business they work in, with a role.
///
/// Replaces the old one-user-one-business 1:1 relation. Every ownership and
/// permission decision in the business and availability modules now resolves
/// through this table.
model BusinessMembership {
  id String @id @default(uuid())

  // NOT unique here, deliberately. One business per person is still the rule,
  // but it applies only to ACTIVE rows — enforced by a PARTIAL unique index
  // that Prisma's DSL cannot express:
  //
  //   CREATE UNIQUE INDEX "business_memberships_active_userId_key"
  //     ON "business_memberships"("userId") WHERE "status" = 'ACTIVE';
  //
  // It lives in the migration for that change. A blanket @unique would let a
  // REMOVED row keep occupying the slot forever, permanently barring someone
  // from ever joining a different business after leaving one.
  //
  // The index is invisible to this schema, so Prisma neither creates nor
  // manages it. Checked with `prisma migrate diff` after applying: Prisma
  // reports no drift and does not propose dropping it — it simply cannot see
  // it. Still worth a glance whenever a generated migration touches this
  // table: if one ever contains DROP INDEX
  // "business_memberships_active_userId_key", delete that line and keep the
  // index, because nothing in the schema would restore it.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  role   BusinessMemberRole
  // Soft delete: removing a member sets REMOVED, keeping the row so the record
  // of who had access survives. Re-hiring into the same business reactivates
  // that row rather than inserting a second one.
  status BusinessMemberStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // At most one row per person per business, so someone's history with a given
  // business is a single row that flips between ACTIVE and REMOVED. This is
  // what makes the reactivation path unambiguous — there can never be two rows
  // to choose between. Expressible in Prisma, unlike the partial index above.
  @@unique([userId, businessProfileId])
  @@index([businessProfileId, status])
  @@index([userId, status])
  @@map("business_memberships")
}

/// A pending invitation for an email address to join a business.
///
/// There is no separate "accept" endpoint: verifying an OTP as a BUSINESS user
/// with a pending invitation IS acceptance. See AuthService.
model BusinessInvitation {
  id String @id @default(uuid())

  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  // Stored lowercase/trimmed, matching how AuthService normalises emails, so
  // invitation lookup at OTP verification is an exact match.
  email String

  // MANAGER or STAFF only — never OWNER. Ownership transfer does not exist in
  // MVP, so there is no path by which an invitation can create a second OWNER.
  role BusinessMemberRole

  invitedByUserId String
  invitedBy       User   @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  expiresAt DateTime

  @@index([email, status])
  @@index([businessProfileId, status])
  @@map("business_invitations")
}

// ---------- Platform settings ----------

/// Admin-tunable platform configuration, held as a single row.
///
/// Single-row rather than key-value: every setting here is strongly typed and
/// arithmetic-bearing, and a key-value table would turn `platformFeePercentage`
/// into a string that every reader has to parse and trust. The `id` is pinned
/// to a constant so there is exactly one row and no way to accidentally create
/// a second.
model PlatformSetting {
  // Fixed sentinel id — see PLATFORM_SETTING_ID in platform-settings.service.ts.
  id String @id

  /// Percentage of the service price taken as the platform's fee, deducted
  /// from the customer's deposit before the remainder reaches the business.
  ///
  /// Editable at runtime by an admin, so every booking reads it live. Already
  /// booked appointments keep the amounts computed at their booking time; see
  /// the snapshot fields on Appointment.
  platformFeePercentage Decimal @default(10.00) @db.Decimal(5, 2)

  /// How many days after an appointment resolves before its money may be paid
  /// out (§38).
  ///
  /// A settling window in which a dispute can still arrive, not a processing
  /// delay. The hold in force AT RESOLUTION TIME is the one that applies:
  /// changing this never rewrites an availableAt that has already been set.
  payoutHoldDays Int @default(2)

  /// The currency the payment provider actually charges in.
  ///
  /// Authoritative — this supersedes the MOMO_CURRENCY env var, so the value
  /// can be corrected by an admin without a redeploy. "EUR" is MTN's sandbox
  /// requirement; production for South Sudan is still unconfirmed.
  providerCurrency String

  /// How many units of providerCurrency one USD buys.
  ///
  /// Set MANUALLY by an admin. Nullable on purpose: there is no sensible
  /// default for an exchange rate, and a wrong guess charges the customer the
  /// wrong amount. Payment initiation fails loudly when this is unset rather
  /// than falling back to anything.
  ///
  /// Decimal(18,8) gives room for both a rate near 1 (USD->EUR) and a rate in
  /// the thousands (USD->SSP) without losing precision at either end.
  exchangeRateUsdToProviderCurrency Decimal? @db.Decimal(18, 8)

  /// When the rate above was last set. Surfaced by the admin endpoint so it is
  /// obvious at a glance how stale a manually-maintained rate has become.
  exchangeRateUpdatedAt DateTime?

  /// Who last set it. A manually-maintained rate that is wrong is a question
  /// with an answer — "when" alone does not say who to ask (§37).
  exchangeRateUpdatedById String?
  exchangeRateUpdatedBy   User?   @relation("ExchangeRateUpdates", fields: [exchangeRateUpdatedById], references: [id], onDelete: SetNull)

  /// How many hours old the rate may be before it is reported as stale.
  ///
  /// Configurable rather than a constant, because the right number depends on
  /// how fast the currency is actually moving — 24 hours is right for a
  /// stable pair and far too slow for a collapsing one.
  ///
  /// Staleness is LOUD, NEVER FATAL (§37.3): a stale rate is still served, and
  /// bookings continue. A platform that stops taking money because nobody
  /// updated a setting is worse than one charging a slightly old rate.
  exchangeRateStalenessHours Int @default(24)

  /// When admins were last told the rate had gone stale, so the daily reminder
  /// is a reminder rather than a stream.
  exchangeRateStaleNotifiedAt DateTime?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ---------- Appointments ----------

/// A booking. Replaces the §12 placeholder with the full lifecycle and money.
/// Who BEARS RESPONSIBILITY for a cancellation.
///
/// Not the same question as who performed it — see Appointment.cancelledByUserId.
/// This is the field the refund policy (§25) keys off: a business cancellation
/// costs the business, a customer cancellation does not, and an unpaid hold
/// released by the sweep is not a cancellation anyone owes anything for.
enum CancelledBy {
  CUSTOMER
  BUSINESS
  SYSTEM_EXPIRY
}

/// HOW an arrival was verified (§54).
///
/// Recorded rather than inferred, and kept as a distinct fact rather than a
/// boolean, for the reason §48 separated admin verification from OTP
/// verification on a payout destination: an arrival proved by a code the
/// customer read out and one a business asserted after answering challenge
/// questions are different facts, and they must not look identical in the
/// table. Null for appointments verified before this existed, and for every
/// appointment not yet verified.
enum VerificationMethod {
  CODE // the customer's 6-digit code was entered and matched
  MANUAL // the code path failed; a business verified against recalled details
}

model Appointment {
  id String @id @default(uuid())

  locationId String
  // Restrict, not Cascade (§89). Deleting a location used to delete every
  // appointment ever made there — and with them the reviews and threads that
  // cascade from an appointment, while ledger entries survived with their
  // appointmentId set to null and nothing left to explain them. Locations are
  // soft-deleted now; this makes the destructive path impossible rather than
  // merely unused, for the same reason the service relation below is Restrict.
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // Required now, unlike the placeholder: an appointment is always for a
  // specific service, because that is what fixes its duration and its price.
  // Restrict, not SetNull — services are soft-deleted precisely so a booked
  // appointment always resolves to the service it was made for.
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  customerId String
  customer   User   @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Cascade)

  // Absolute instants, unlike the wall-clock "HH:mm" strings used by hours,
  // exceptions and blocks. endTime is derived server-side from the service's
  // durationMinutes at booking time, never accepted from the client.
  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(PENDING_PAYMENT)

  // ---- Money, snapshotted at booking time ----
  //
  // All three are integer cents and satisfy, permanently:
  //     platformFeeAmountMinor + businessAmountMinor == depositAmountMinor
  //
  // They are stored rather than derived because every input can move
  // afterwards: an admin may change the platform fee, and a business may
  // change its price or deposit percentage. What the customer agreed to pay,
  // and what the business is owed, must not silently change with them.
  depositAmountMinor     Int
  platformFeeAmountMinor Int
  businessAmountMinor    Int

  /// The INPUTS the three amounts above were computed from, snapshotted at
  /// booking and never updated.
  ///
  /// Without these the amounts cannot be explained after the fact: the service
  /// price and its deposit percentage are both editable (§10), and the platform
  /// fee percentage is an admin setting (§16.3), so joining to them later gives
  /// today's values for a historical booking. Recording the inputs alongside
  /// the outputs is what makes a past appointment reconstructable — and what
  /// makes the balance owed to the business computable at all (§29.1).
  ///
  /// Nullable with no backfill: appointments booked before this existed
  /// genuinely do not have the information, and inventing it would be worse
  /// than admitting it. Every reader must treat null as "not recorded".
  servicePriceMinor Int?

  // ---- How many (§136), snapshotted with the money ----
  //
  // servicePriceMinor above is the price of the WHOLE booking; unitPriceMinor
  // is the price of one. capacityUnits is how many of the branch's places the
  // booking occupies at once, which is what availability counts.
  quantity              Int      @default(1)
  capacityUnits         Int      @default(1)
  unitPriceMinor        Int?
  depositPercentage     Decimal? @db.Decimal(5, 2)
  platformFeePercentage Decimal? @db.Decimal(5, 2)

  /// ISO 4217 code covering all three amounts above. One field rather than
  /// three: a deposit, the fee taken from it, and the remainder are by
  /// construction the same currency, so separate fields could only ever
  /// disagree by accident.
  currency String

  // ---- Deposit payment ----
  //
  // The provider's own reference for the in-flight request-to-pay, used to poll
  // its outcome. Null when no payment has been started, and CLEARED on failure
  // so the customer can initiate a fresh attempt — a failed reference is not
  // retryable at the provider, so keeping it would strand the appointment.
  paymentProviderReferenceId String?
  paymentInitiatedAt         DateTime?

  /// WHICH operator holds that reference (§57.2).
  ///
  /// Not bookkeeping — the payment poller cannot work without it. A reference
  /// is meaningful only to the operator that issued it, so asking MTN about an
  /// Airtel transaction returns "no such transaction", which is
  /// indistinguishable from a genuine failure. With one operator configured the
  /// question never arose and the column was not needed; with two it is the
  /// difference between confirming a payment and cancelling a paid booking.
  ///
  /// Backfilled, unlike §33's actor columns, because the answer is actually
  /// known: exactly one provider implementation has ever existed, so every
  /// historical payment went through MTN. This is a case where inferring is
  /// honest — there was only one possible answer.
  paymentProvider MobileMoneyProvider?

  /// What was actually sent to the provider, and the rate used to get there.
  ///
  /// Kept ALONGSIDE the USD amounts rather than replacing them. Reconciliation
  /// needs both numbers: when the provider's statement shows a figure that does
  /// not match our USD ledger, the only way to explain the difference rather
  /// than merely observe it is to have recorded the converted amount and the
  /// rate that produced it. Storing just one side makes a discrepancy
  /// permanently unexplainable.
  ///
  /// Null until a payment is initiated.
  providerCurrency    String?
  providerAmountMinor Int?
  exchangeRateUsed    Decimal? @db.Decimal(18, 8)

  // ---- Arrival verification ----
  //
  // The customer receives a 6-digit code by email; the business enters it to
  // prove the customer actually turned up. Bcrypt-hashed exactly like OTP
  // codes — the raw code is never stored.
  verificationCodeHash String?
  verificationAttempts Int       @default(0)
  verifiedAt           DateTime?

  /// When the arrival code was LAST emailed (§53.2, §54.1).
  ///
  /// A timestamp, never the code. Nothing in the booking response previously
  /// said a code had been sent or would be needed, so a client had to know it
  /// from documentation — and a customer who never received the email had no
  /// signal that one was owed to them.
  ///
  /// Since §54 this moves on every resend, and is what the resend cooldown is
  /// measured from.
  verificationCodeSentAt DateTime?

  /// The live arrival code, readable (§54.2).
  ///
  /// Stored ALONGSIDE the bcrypt hash above, never instead of it: `verify()`
  /// still compares against the hash, so the verification path is unchanged and
  /// keeps bcrypt's constant-time comparison. This column exists only so the
  /// customer's own app can DISPLAY the code, which a hash cannot do.
  ///
  /// Both are written from the same generated value, in the same statement,
  /// in the two places a code is ever issued — creation and resend — so they
  /// cannot drift.
  ///
  /// EXPOSURE: returned only on a customer's read of their OWN appointment, and
  /// only while the code can still be used. It is never selected into the
  /// shared appointment projection, so a business or admin read cannot leak it
  /// by omission — showing it takes a deliberate act rather than remembering to
  /// strip it (§54.2).
  ///
  /// Null for appointments created before §54; those rows keep working through
  /// the hash, and their customers use the emailed code as before. No backfill,
  /// because the plaintext is genuinely unrecoverable from a bcrypt hash.
  verificationCode String?

  /// How many times a code has been emailed for this appointment, including the
  /// first (§54.1). Caps resends, so the endpoint cannot be used to mail-bomb a
  /// customer.
  verificationCodeSentCount Int @default(1)

  /// How the arrival was verified, and by whom (§54.3).
  ///
  /// `verifiedById` is the business user who performed it — the same
  /// separation §33.2 drew between the party responsible and the person who
  /// acted, and it is what makes a manual verification attributable.
  verificationMethod VerificationMethod?
  verifiedById       String?
  verifiedBy         User?               @relation("VerifiedAppointments", fields: [verifiedById], references: [id], onDelete: SetNull)

  /// What the customer recalled, when the code path could not be used (§54.3).
  ///
  /// Free text, required for a manual verification and null for every other.
  /// Deliberately NOT validated against the appointment: every fact a server
  /// could check here — the service, the time, the price — is already visible
  /// to the business in its own booking list, so checking them would verify
  /// that the business can read its own screen, not that the customer is
  /// present. The control on this path is that it is recorded, attributed and
  /// reviewable, not that it is guessed correctly (§54.3).
  manualVerificationNote String?

  // Transition timestamps. Kept separate from updatedAt so the auto-transition
  // job, and any later audit, can tell when each clock actually started.
  completedAt DateTime?
  cancelledAt DateTime?
  noShowAt    DateTime?

  // ---- Who cancelled, and why (§33) ----
  //
  // §25's refund policy turns on WHICH party called an appointment off, and
  // until these existed nothing recorded it: cancel() derived the actor to
  // write a notification sentence and then threw it away.
  //
  // Two fields, deliberately not one:
  //
  //   cancelledBy       — the party who bears responsibility, which is what
  //                       decides the money outcome.
  //   cancelledByUserId — who physically performed the action.
  //
  // Usually the same person, and deliberately not always. When an admin
  // resolves a dispute by reclassifying an appointment as business-cancelled,
  // cancelledBy is BUSINESS while cancelledByUserId is the admin, and
  // cancellationTicketId links the ticket that says why. Collapsing them would
  // force a second refund path for admin-resolved cancellations.
  //
  // Null for the expiry sweep, which has no acting user.
  cancelledBy       CancelledBy?
  cancelledByUserId String?
  cancelledByUser   User?        @relation("CancelledAppointments", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  /// Required when a business cancels, optional when a customer does, null for
  /// the sweep. A business cancellation costs the business money under §25, so
  /// it should be a deliberate act with a stated reason.
  cancellationReason String?

  /// Set when the cancellation came out of a support ticket rather than the
  /// self-service route. It is what makes an admin reclassification auditable.
  cancellationTicketId String?
  cancellationTicket   Ticket? @relation("CancellationTickets", fields: [cancellationTicketId], references: [id], onDelete: SetNull)

  /// When the deposit was confirmed by the provider. Set once, never cleared.
  ///
  /// Status cannot answer "was this ever paid?" because later transitions
  /// destroy the evidence: once an appointment is CANCELLED, nothing remains to
  /// distinguish an expired unpaid hold from a deposit that was taken and then
  /// called off. That is why the collected-deposits figure was only ever a
  /// floor (§29.1). A timestamp survives every subsequent transition.
  depositPaidAt DateTime?

  /// Set when the pre-appointment reminder goes out, so the sweep never sends
  /// the same reminder twice. A timestamp rather than a boolean so it is
  /// visible *when* the customer was reminded.
  reminderSentAt DateTime?

  /// The payout hold, in days, that was in force when this appointment resolved
  /// (§38.2). Recorded so a payout date can be explained afterwards without
  /// knowing the setting's history — which nothing stores.
  ///
  /// Null until the appointment resolves, and for appointments resolved before
  /// the hold became configurable.
  payoutHoldDaysApplied Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  thread        Thread?
  // Named because there are now TWO relations to Ticket: tickets raised ABOUT
  // this appointment, and the single ticket a cancellation came out of.
  tickets       Ticket[]            @relation("TicketAppointment")
  adjustments   BillingAdjustment[]
  review        Review?
  ledgerEntries LedgerEntry[]

  // Availability counts overlapping appointments at one location for one day.
  @@index([locationId, startTime])
  // The customer's own list, newest first.
  @@index([customerId, startTime])
  // Drives the auto-transition sweep, which scans by status and end time.
  @@index([status, endTime])
  // Drives the payment-confirmation poll and the PENDING_PAYMENT expiry sweep,
  // both of which scan by status and creation time.
  @@index([status, createdAt])
  @@map("appointments")
}

/// A message sent to one person about one event.
///
/// Stored rather than fire-and-forget for two reasons. It is the audit trail —
/// when a business says nobody told them about a booking, the row either exists
/// or it does not — and it is the in-app inbox, so a frontend can list
/// notifications later without a schema change.
model Notification {
  id String @id @default(uuid())

  /// Who it is for. Cascades: a deleted account's notifications are of no use
  /// to anyone, unlike an appointment, which is a financial record.
  recipientId String
  recipient   User   @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel @default(EMAIL)
  status  NotificationStatus  @default(PENDING)

  /// Rendered at send time and kept, so the inbox shows exactly what was sent
  /// rather than re-rendering against data that has since changed — a
  /// cancelled appointment must not rewrite the message that announced it.
  subject String
  body    String

  /// The appointment this concerns, when it concerns one. SetNull rather than
  /// Cascade: the notification is evidence that something was communicated and
  /// should outlive the record it referred to.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// Null until the recipient marks it read. Not a boolean, so "when" is
  /// answerable later without another column.
  readAt      DateTime?
  /// Taken off the list by its recipient (§159). Kept: the row is also the delivery record.
  dismissedAt DateTime?

  sentAt       DateTime?
  failureCount Int       @default(0)
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The inbox query: one recipient, newest first.
  @@index([recipientId, createdAt])
  @@index([recipientId, dismissedAt, readAt])
  /// The retry sweep: everything not yet delivered.
  @@index([status])
  @@map("notifications")
}

// ---------- Chat ----------

/// A conversation between one customer and one business.
///
/// ONE model covers both cases, distinguished only by whether appointmentId is
/// set. Two tables would duplicate every message, read-state and permission
/// rule for a distinction that matters only at creation time.
///
/// - appointmentId SET  — tied to a booking, created automatically with it.
/// - appointmentId NULL — a pre-booking inquiry, created on demand, exactly
///   one per (customer, business) pair and reused forever after.
model Thread {
  id String @id @default(uuid())

  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  customerId String
  customer   User   @relation("CustomerThreads", fields: [customerId], references: [id], onDelete: Cascade)

  /// Unique when set, which a plain @unique gives us: Postgres treats NULLs as
  /// distinct, so any number of inquiry threads coexist while a booking can
  /// have at most one thread.
  ///
  /// Cascade: an appointment-scoped thread has no meaning without its
  /// appointment. Inquiry threads are unaffected — they have no appointment.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Denormalised so the thread list can sort by recency without joining and
  /// aggregating messages on every request. Updated on each new message.
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages   Message[]
  readStates ThreadReadState[]

  /// "One inquiry thread per customer-business pair" cannot be expressed here:
  /// it must apply only WHERE appointmentId IS NULL, and Prisma's DSL has no
  /// partial index. It is created in the migration as
  /// "threads_inquiry_customer_business_key" — the same pattern, and the same
  /// caveat, as BusinessMembership's active-only index (§15.3).
  @@index([businessProfileId, lastMessageAt])
  @@index([customerId, lastMessageAt])
  @@map("threads")
}

/// One message. Text, a photo, or both — never neither.
model Message {
  id       String @id @default(uuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  /// Both nullable, but a message with neither is rejected in the service. A
  /// CHECK constraint enforces the same rule in the database, since an empty
  /// message is meaningless however it is inserted.
  body     String?
  photoUrl String?

  createdAt DateTime @default(now())

  /// The message list: one thread, chronological.
  @@index([threadId, createdAt])
  @@map("messages")
}

/// Per-person read position within a thread.
///
/// One row per (thread, user) rather than a single flag on Thread, because a
/// business has several members (§14) and an owner reading a message must not
/// silently mark it read for the staff member who actually has to answer it.
model ThreadReadState {
  id       String @id @default(uuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ThreadReadStates", fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime

  /// When this person was last emailed about this thread. Lives here because
  /// the key is identical — per thread, per person — and a second table would
  /// duplicate it for no gain. Drives the notification debounce, the same
  /// claim-a-timestamp trick used for appointment reminders (§20.5).
  lastNotifiedAt DateTime?

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_read_states")
}

// ---------- Support tickets ----------
//
// Deliberately NOT built on Chat's Thread/Message (§21). The participants are
// different — a reporter and the platform's admins, rather than a customer and
// a business — and tickets carry status, assignment and resolution that a chat
// thread has no notion of. These tables borrow Chat's proven shapes without
// sharing its models.

/// A problem reported to the platform admins.
model Ticket {
  id String @id @default(uuid())

  /// Human-quotable in an email or a phone call, e.g. "TKT-000123". Generated
  /// from a Postgres sequence inside the creating transaction, so concurrent
  /// creates cannot collide the way a count-and-increment read would.
  reference String @unique

  reporterId   String
  reporter     User         @relation("ReportedTickets", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterType ReporterType

  /// Set when reporterType = BUSINESS. It is what lets every member of that
  /// business see the ticket, not only the person who raised it.
  businessId      String?
  businessProfile BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Optional — a ticket may be general ("I cannot log in"). When present, the
  /// reporter is verified to be a party to it at creation.
  ///
  /// Named because there are now two Appointment<->Ticket relations; see
  /// citedByCancellations below.
  appointmentId String?
  appointment   Appointment? @relation("TicketAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)

  category TicketCategory
  subject  String
  status   TicketStatus   @default(OPEN)

  assignedAdminId String?
  assignedAdmin   User?   @relation("AssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  /// Required to move IN_PROGRESS -> RESOLVED. A resolution with no
  /// explanation is not a resolution the reporter can act on.
  resolutionNote String?

  resolvedAt  DateTime?
  closedAt    DateTime?
  reopenedAt  DateTime?
  reopenCount Int       @default(0)

  /// Denormalised so the admin queue sorts by recency without aggregating
  /// messages on every request — the same trick Thread.lastMessageAt uses.
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    TicketMessage[]
  attachments TicketAttachment[]
  adjustments BillingAdjustment[]

  /// Cancellations that cite this ticket as their reason.
  citedByCancellations Appointment[] @relation("CancellationTickets")

  /// The admin queue: open work, most recently active first.
  @@index([status, lastMessageAt])
  @@index([reporterId])
  @@index([businessId])
  @@map("tickets")
}

model TicketMessage {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId   String
  author     User             @relation("TicketMessages", fields: [authorId], references: [id], onDelete: Cascade)
  authorType TicketAuthorType

  body String

  /// An admin-only note. Filtered out in the QUERY for every reporter-facing
  /// read, never removed after the fact — a filter applied late is a filter
  /// someone eventually forgets to apply.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Null when attached to the ticket itself rather than to a later message.
  ticketMessageId String?
  ticketMessage   TicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)

  url       String
  mimeType  String
  sizeBytes Int

  uploadedById String
  uploadedBy   User   @relation("TicketAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

/// A fee credit or charge an admin recorded while resolving a ticket.
///
/// NOTE: this table records ADMIN INTENT only. Nothing writes to it
/// automatically and nothing consumes it — no money moves because a row exists
/// here. The platform fee is taken from the customer's deposit at booking
/// (DECISIONS.md §2, §16.3), so settlement means reversing that charge at the
/// payment provider, not adjusting an invoice. See §25.
model BillingAdjustment {
  id String @id @default(uuid())

  businessId      String
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  type   BillingAdjustmentType
  amount Decimal               @db.Decimal(12, 2)
  reason String

  /// When the money actually moved, and the provider's reference for it.
  /// Both null until something settles this adjustment — nothing does yet, so
  /// every row is unsettled by definition. They exist so that when refunds are
  /// built, a settled adjustment is distinguishable from an outstanding one
  /// without a second table.
  settledAt     DateTime?
  settlementRef String?

  /// The ledger entry this adjustment produced when it was executed. At most
  /// one — an adjustment executes once (§36).
  ledgerEntries LedgerEntry[]

  createdById String
  createdBy   User   @relation("CreatedAdjustments", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// The query a future settlement run makes: this business's outstanding rows.
  @@index([businessId, settledAt])
  @@map("billing_adjustments")
}

// ---------- Money owed to businesses ----------

/// One immutable fact about money, from a business's point of view (§34).
///
/// A business's balance is ALWAYS the sum of its entries. There is deliberately
/// no balance column anywhere: a stored total and the rows that justify it drift
/// the first time a write fails halfway, and then no one can tell which is
/// right. Summing is cheap, and it can only ever be wrong if an entry is wrong.
///
/// IMMUTABLE after insert: `type`, `amountMinor`, `currency`, `businessId`,
/// `appointmentId` and `createdAt` are never updated — enforced by a database
/// trigger, not by convention. Only `availableAt` and `payoutId` may be written
/// later, because those record what happened to an entry, not what it says.
/// Corrections are made by appending an opposing entry. An edited ledger is not
/// a ledger.
model LedgerEntry {
  id String @id @default(uuid())

  businessId      String
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Null for entries that do not arise from one appointment — a manual
  /// adjustment, say. SetNull rather than Cascade: a deleted appointment must
  /// not silently delete the record of money that moved because of it.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  type LedgerEntryType

  /// SIGNED, from the business's perspective. Positive is owed to them,
  /// negative is owed back. Integer cents, like every other money column.
  amountMinor Int

  currency String

  // ---- Settlement, fixed at booking (§45) ----
  //
  // amountMinor above stays the USD reporting and analytics figure.
  // settlementAmountMinor is AUTHORITATIVE FOR PAYOUTS, and carries the same
  // sign as amountMinor.
  //
  // The business's payable is fixed at the booking-date rate, so a payout
  // performs no conversion and reads no exchange rate: every entry already
  // carries the amount it will be paid in. A rate change between booking and
  // payout must not move a payout by a single minor unit.
  //
  // Nullable only because entries created before §45, or whose appointment
  // never recorded a charged amount, genuinely have no settlement figure.
  // Those are EXCLUDED from payouts rather than converted at a guessed rate.
  //
  // STILL OPTIONAL HERE, AND NO LONGER WRITABLE AS NULL (§115). A hand-written
  // CHECK constraint — `ledger_entries_settlement_present`, added NOT VALID —
  // refuses any new entry missing either one, while leaving the pre-§45 rows
  // exactly as they are. They stay optional in this model because the old rows
  // are real and Prisma must be able to read them; making them required here
  // would be a lie about what the table holds.
  //
  // Not NOT NULL, because that applies to history too, and the only way to
  // satisfy it is to backfill — which on an append-only ledger means disabling
  // `ledger_entries_immutable`, the trigger that names these very columns.
  settlementCurrency    String?
  settlementAmountMinor Int?
  /// The rate in force when the entry was created, kept so a settlement figure
  /// can be explained afterwards without knowing the rate's history.
  bookingExchangeRate   Decimal? @db.Decimal(18, 8)

  /// When this entry becomes payable. NULL means "not yet" — the appointment it
  /// came from has not resolved. Set once the outcome is known: a week after
  /// completion, or a week after the scheduled end time for an appointment that
  /// never reached COMPLETED (§34.3).
  availableAt DateTime?

  /// The payout that settled this entry. NULL means unsettled — which is also
  /// the definition of money the platform is still holding.
  ///
  /// SetNull is not an accident: marking a payout FAILED unstamps its entries
  /// so they return to the pool and go out on the next run (§35.4).
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  /// Set when this entry came from executing a BillingAdjustment, so the
  /// correction and its ledger effect are traceable in both directions.
  billingAdjustmentId String?
  billingAdjustment   BillingAdjustment? @relation(fields: [billingAdjustmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// The payout run's query: this business's unsettled, now-payable entries.
  @@index([businessId, payoutId, availableAt])
  /// The payout run's grouping key (§45): one business, one currency.
  @@index([businessId, settlementCurrency, payoutId])
  /// Everything that happened to one appointment.
  @@index([appointmentId])
  @@map("ledger_entries")
}

/// One transfer of money to one business (§35).
///
/// A payout does not hold its own arithmetic: `amountMinor` is the sum of the
/// entries stamped with its id at the moment it was created, and those entries
/// remain the authority. The column exists so the figure a business was told
/// survives even if an entry is later reclassified by an opposing entry.
model Payout {
  id String @id @default(uuid())

  businessId      String
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// The USD figure, for reporting. NOT what is sent (§45.1).
  amountMinor Int
  currency    String

  /// What is actually transferred, and in what. Summed from the entries'
  /// settlementAmountMinor with NO conversion and no rate read (§46).
  settlementCurrency    String
  settlementAmountMinor Int

  status PayoutStatus @default(PENDING)

  /// OUR reference for an automated transfer, chosen before it is sent (§64.3).
  ///
  /// Written together with status PROCESSING BEFORE the operator is called,
  /// never after. The other order loses money: if the call succeeds and this
  /// process dies before recording anything, the payout still reads PENDING and
  /// the next person to press send pays the business twice. Written first, a
  /// crash leaves a PROCESSING row whose outcome can be asked for.
  providerReferenceId String?

  /// When the transfer was handed to the operator. Null on the manual path,
  /// where nothing is handed to anyone.
  sentAt DateTime?

  /// The provider's reference for the transfer — typed in by the admin who made
  /// it on the manual path, or read back from the operator on the automated one.
  /// Required to mark a payout PAID: a payout with no reference cannot be
  /// reconciled against a bank or provider statement, which is the only thing
  /// that proves the money left.
  reference String?

  /// Why it failed. Required to mark a payout FAILED, for the same reason a
  /// hidden review needs one — this returns money to the pool and someone will
  /// ask later why it did not go out.
  failureReason String?

  /// When the run selected its entries.
  runAt  DateTime
  paidAt DateTime?

  createdAt DateTime @default(now())

  entries LedgerEntry[]

  /// The admin queue and a business's own history, newest first.
  @@index([businessId, status])
  @@index([status, runAt])
  @@map("payouts")
}

/// Where one business's payouts are sent (§48).
///
/// APPEND-ONLY history with one live row per business. A new submission
/// SUPERSEDES the previous row; a VERIFIED row is never mutated, because the
/// record of where money was actually sent has to survive the number changing.
/// Sending money to the wrong number is the one mistake in this system that
/// cannot be undone by appending a correcting entry (§34.2) — so the history is
/// the audit trail for the only irreversible thing the platform does.
model PayoutDestination {
  id String @id @default(uuid())

  businessId      String
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// E.164, validated against a configurable expected country prefix (§48.2).
  msisdn   String
  provider MobileMoneyProvider @default(MTN_MOMO)

  status PayoutDestinationStatus @default(UNVERIFIED)

  submittedById String
  submittedBy   User     @relation("SubmittedPayoutDestinations", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedAt   DateTime @default(now())

  /// Null when verification did not come from a user — an OTP to the number's
  /// holder, who has no account here.
  verifiedById String?
  verifiedBy   User?     @relation("VerifiedPayoutDestinations", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  verificationMethod PayoutVerificationMethod?

  /// How the admin confirmed it. Required for ADMIN verification: "verified" on
  /// its own is not a record anybody can audit.
  verificationNote String?

  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([businessId, status])
  @@index([status, submittedAt])
  @@map("payout_destinations")
}

// ---------- Reviews ----------

/// A customer's review of one appointment, scoped to the LOCATION it happened
/// at rather than to the business.
///
/// Per-location is the product decision: a chain's well-run branch should not
/// be dragged down by a badly-run one, and a customer choosing between two
/// branches is choosing between those branches, not between companies.
model Review {
  id String @id @default(uuid())

  /// One review per completed appointment, enforced HERE rather than by a
  /// read-then-write check — two concurrent submissions both pass a read and
  /// only the unique index stops the second.
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  customerId String
  customer   User   @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)

  /// Both denormalised from the appointment at creation and never accepted
  /// from the request: a review must describe where the service actually
  /// happened, not where the reviewer says it did.
  businessId      String
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  rating  Int // 1-5, validated in the DTO and by a CHECK constraint
  comment String?

  /// Set on any customer edit. Surfaced in responses, because a rating that
  /// changed after a business replied is context the reader needs.
  editedAt DateTime?

  // ---- Moderation ----
  //
  // Soft-hide: hidden reviews leave public listings and aggregates but stay in
  // the table. A hidden review is usually the evidence in the ticket that got
  // it hidden, so deleting it destroys the record of why.
  hiddenAt     DateTime?
  hiddenReason String?
  hiddenById   String?
  hiddenBy     User?     @relation("HiddenReviews", fields: [hiddenById], references: [id], onDelete: SetNull)

  // ---- Business response ----
  //
  // Fields on the review rather than a table, because the rule is exactly one
  // response per review and a separate table would imply many.
  responseText     String?
  responseAt       DateTime?
  responseById     String?
  responseBy       User?     @relation("ReviewResponses", fields: [responseById], references: [id], onDelete: SetNull)
  responseEditedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The public listing: one location, visible reviews, newest first.
  @@index([locationId, hiddenAt, createdAt])
  @@index([businessId])
  @@map("reviews")
}

model OtpCode {
  id          String     @id @default(uuid())
  email       String
  codeHash    String // never store the raw code
  purpose     OtpPurpose @default(LOGIN)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The role to create the account with, when this code is for a brand-new
  /// email (§50). NULL for every existing user — they log in as whoever they
  /// already are, and the request body does not get a vote.
  ///
  /// It lives here rather than on the verify request because role belongs to
  /// REGISTRATION, not authentication: the decision was made when the code was
  /// asked for, and re-asking at verify time was both redundant and the reason
  /// administrators could not log in at all.
  registrationRole UserRole?

  @@index([email, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // raw refresh token is never stored, only its hash
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// An invitation to become an administrator (§99).
///
/// Deliberately a separate table from BusinessInvitation rather than a nullable
/// businessProfileId on it: the two confer different things, are sent by
/// different people, and a single table would need a check constraint saying
/// "business invitations have a business and admin ones do not", which is a
/// comment pretending to be a schema.
///
/// The invitation is what confers the role. `POST /auth/otp/request` refuses a
/// role of ADMIN from any client, so the only way to become one is for the
/// primary administrator to have written a row here.
model AdminInvitation {
  id    String @id @default(uuid())
  email String

  invitedByUserId String
  invitedBy       User   @relation("AdminInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Looked up by address on every registration, so it is the index that matters.
  @@index([email, status])
  @@map("admin_invitations")
}

/// Rwanda's five provinces (§104).
///
/// Reference data, seeded in a migration and never edited through the API.
/// `code` exists so a seed, a test or a support query can name one without
/// carrying a UUID around.
model Province {
  id   String @id @default(uuid())
  code String @unique
  name String @unique

  /// Whether this is a single CITY whose districts are neighbourhoods (§106).
  ///
  /// True for the City of Kigali, which has special status in Rwanda and is one
  /// place to anyone living in it — Gasabo and Kicukiro are parts of Kigali,
  /// not alternatives to it. False for the four rural provinces, whose
  /// districts are separate towns hours apart: Rubavu and Rusizi are both
  /// "Western Province", and nobody looking for either would search for that.
  ///
  /// A flag rather than special-casing the KIGALI code in the clients, because
  /// three apps would each need the same exception and one would forget.
  isCity Boolean @default(false)

  districts District[]

  @@map("provinces")
}

/// The thirty districts, each inside exactly one province.
///
/// This is the level that actually discriminates in the launch market: every
/// business on the platform today is in the City of Kigali, so a province
/// filter there offers one option and answers nothing. Districts split the
/// same businesses across Gasabo, Kicukiro and Nyarugenge.
model District {
  id   String @id @default(uuid())
  code String @unique
  name String

  /// Whether the platform is open here (§105).
  ///
  /// Rwanda's thirty districts are a fact; which of them this platform trades
  /// in is a decision. Retiring one stops a NEW branch choosing it and takes
  /// it out of the customer's filter — branches already there keep their
  /// listing, exactly as a retired category does (§98.1).
  ///
  /// Never deleted. §101: this platform retires and does not erase.
  isLive Boolean @default(true)

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  locations Location[]
  residents User[]     @relation("HomeDistrict")

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("districts")
}

/// A place a customer saved to come back to (§120).
///
/// A LOCATION, not a business, for the same reason a search result is one
/// (§43): a customer saves the branch they would actually walk into, and a
/// chain's two branches are different answers to "where shall I go".
///
/// Deliberately NOT a cart. Nothing here is reserved, nothing is priced and
/// nothing is paid for — a slot is held by booking it, and holding one by
/// putting it in a basket would take it away from somebody who was ready.
/// A saved SERVICE at a branch (§158), beside the saved places below.
model ServiceFavourite {
  id String @id @default(uuid())

  customerId String
  customer   User   @relation("CustomerServiceFavourites", fields: [customerId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation("ServiceFavourites", fields: [serviceId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation("LocationServiceFavourites", fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, serviceId, locationId])
  @@index([customerId, createdAt])
  @@map("service_favourites")
}

model Favourite {
  id String @id @default(uuid())

  customerId String
  customer   User   @relation("CustomerFavourites", fields: [customerId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation("LocationFavourites", fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Saving twice is the same as saving once. The unique index is what makes
  /// that true under a double tap, rather than a read-then-write that both
  /// requests pass.
  @@unique([customerId, locationId])
  /// The only query there is: this customer's saved places, newest first.
  @@index([customerId, createdAt])
  @@map("favourites")
}

/// Which document this is. Fixed, not admin-defined: each one is referred to by
/// name in the apps and in law, and a free-text kind would let two "Privacy
/// Policy" rows exist with nothing to say which is the real one.
enum LegalDocumentKind {
  TERMS_OF_USE
  PRIVACY_POLICY
  SELLER_AGREEMENT
}

/// One VERSION of one legal document (§122).
///
/// Append-only in spirit: publishing never edits the published row, it writes a
/// new version. What somebody agreed to has to stay readable exactly as they
/// read it — a privacy policy that can be rewritten under the people who
/// accepted it records nothing at all.
///
/// A draft is a row with `publishedAt` null. It can be edited freely, because
/// nobody has seen it and nobody has agreed to it.
model LegalDocument {
  id String @id @default(uuid())

  kind LegalDocumentKind

  /// 1, 2, 3 … per kind. The number people quote at each other.
  version Int

  /// What the apps show as the heading. Editable per version, because the
  /// Seller Agreement may one day be the Business Terms.
  title String

  /// The document itself. Plain text with blank lines between paragraphs — no
  /// HTML, because an admin pasting from a word processor would paste markup
  /// that the two apps would then have to agree about rendering, and one of them
  /// is a phone.
  body String

  /// Null while it is a draft. Set once, never cleared: unpublishing would hide
  /// the terms somebody is currently bound by.
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("PublishedLegalDocuments", fields: [publishedById], references: [id], onDelete: SetNull)

  /// A one-line note on what changed, shown beside "this has been updated".
  /// Nobody rereads four thousand words to find the sentence that moved.
  changeNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acceptances LegalAcceptance[]

  /// One row per version per kind.
  @@unique([kind, version])
  @@index([kind, publishedAt])
  @@map("legal_documents")
}

/// Who agreed to what, and when (§122.3).
///
/// Keyed on the DOCUMENT, not on the kind: "they accepted the privacy policy" is
/// worth nothing without saying which one, and the whole reason versions are
/// kept is so that question has an answer years later.
model LegalAcceptance {
  id String @id @default(uuid())

  userId String
  user   User   @relation("LegalAcceptances", fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  acceptedAt DateTime @default(now())

  /// Accepting twice is accepting once.
  @@unique([userId, documentId])
  @@index([userId])
  @@map("legal_acceptances")
}

/// A service somebody started writing and has not finished (§123).
///
/// A SEPARATE table, not a flag on `Service`, and that is the whole design. A
/// draft living in `services` would be one forgotten `where` away from a
/// customer seeing a half-written service with no price — and §119 had just
/// finished widening a predicate because exactly that kind of filter was missed
/// in two places. A draft cannot leak out of a query it is not in.
///
/// Per BUSINESS, not per person. A shop is a shared workspace (§21.3): an owner
/// starting something and a manager finishing it is normal, and two people each
/// holding invisible half-finished services is not. Who started it is recorded
/// so the shop knows whose work it is.
model ServiceDraft {
  id String @id @default(uuid())

  businessId      String
  businessProfile BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedServiceDrafts", fields: [createdById], references: [id], onDelete: Cascade)

  /// Everything is optional. A draft exists precisely because it is incomplete,
  /// so validating it would defeat the point — the rules apply when it is turned
  /// into a real service, and not before.
  name              String?
  description       String?
  durationMinutes   Int?
  depositPercentage Decimal? @db.Decimal(5, 2)

  /// The per-branch prices, as written so far: `[{ locationId, priceMinor }]`.
  ///
  /// JSON rather than rows, because a draft's offers point at nothing yet and a
  /// relational shape would need its own table, its own cascade and its own
  /// cleanup for data that is thrown away the moment the service is created.
  offers Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, updatedAt])
  @@map("service_drafts")
}

/// A mobile money number somebody has used before (§124.2).
///
/// Stored so a customer does not retype it at the one moment they are least
/// patient. It changes nothing about how a payment works: the number is still
/// sent to the same endpoint, validated by the same DTO and charged by the same
/// provider — this is a keyboard shortcut, not a payment method.
///
/// No token, no mandate, no stored credential. MTN charges by prompting the
/// handset, so there is nothing to keep that could be used without the person
/// holding the phone. That is worth saying plainly: a table called "payment
/// methods" invites somebody to one day put a card in it.
model SavedPaymentNumber {
  id String @id @default(uuid())

  userId String
  user   User   @relation("SavedPaymentNumbers", fields: [userId], references: [id], onDelete: Cascade)

  /// MSISDN, digits only — the shape the operator takes (§109.2), normalised
  /// before it is stored so one number cannot be saved twice wearing spaces.
  phoneNumber String

  /// Which operator to charge through, when the customer knows better than the
  /// prefix does (§58.1). Null means "work it out from the number".
  provider MobileMoneyProvider?

  /// What they call it. "Mine", "My wife's", "The shop phone".
  label String?

  createdAt  DateTime  @default(now())
  /// Moves the one they actually use to the top, without asking them to rank.
  lastUsedAt DateTime?

  /// One row per number per person. Saving the same one twice is saving it once.
  @@unique([userId, phoneNumber])
  @@index([userId, lastUsedAt])
  @@map("saved_payment_numbers")
}

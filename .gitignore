# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Next.js / Vite / frontend build artifacts (for apps/*-web added later)
.next/
out/
.turbo/
.vite/
.cache/

# Environment — never commit real secrets. Only .env.example is tracked.
.env
.env.*
!.env.example
!.env.*.example

# Prisma
# Migration files ARE committed; only local artifacts are ignored.
prisma/*.db
prisma/*.db-journal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Docker local volumes
docker-data/

# Vite build output for the frontend apps
apps/*/dist/

# Logs from scripts/dev.sh
.dev-logs/
